---
// «رحلتي»: الطريق يبدأ من الأعلى وينتهي عند الشمس في الأسفل، فيرى المستخدم بدايته وخطوته الحالية أولًا.
// القائمة بترتيب الخطوات (1 أولًا) لقارئ الشاشة. كل عقدة رابط إلى خطوتها.
interface S { id: string; position: number; title: string; state: string }
interface Props { steps: S[]; current: string | null; hrefBase: string }
const { steps, current, hrefBase } = Astro.props;
const H = 82, W = 350, n = steps.length;
const total = (n + 1) * H;
// العقدة i (من الأعلى) عند ارتفاع ثابت، وتتمايل يمينًا ويسارًا. نبدأ من اليمين (اتجاه القراءة)
const pts = steps.map((_, i) => ({ x: Math.round(W * (0.5 + 0.26 * Math.sin(i * 1.05 + 0.9))), y: Math.round((i + 0.5) * H) }));
const end = { x: Math.round(W * 0.5 + W * 0.26 * Math.sin(n * 1.05 + 0.9)), y: Math.round(total - H * 0.45) };
const all = [...pts, end];
function smooth(p: { x: number; y: number }[]) {
  if (!p.length) return '';
  let d = `M${p[0].x} ${p[0].y}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] ?? p[i], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2] ?? p2;
    const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 }, c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
    d += ` C${Math.round(c1.x)} ${Math.round(c1.y)} ${Math.round(c2.x)} ${Math.round(c2.y)} ${p2.x} ${p2.y}`;
  }
  return d;
}
const cur = current ? steps.findIndex((s) => s.id === current) : steps.findIndex((s) => s.state !== 'completed');
const reach = cur < 0 ? all.length - 1 : cur;
const pct = (x: number) => `${((x / W) * 100).toFixed(1)}%`;
---
<div class="road" style={`height:${total}px`}>
  <svg viewBox={`0 0 ${W} ${total}`} preserveAspectRatio="none" aria-hidden="true">
    <path d={smooth(all)} fill="none" stroke="var(--track)" stroke-width="4" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
    {reach > 0 && <path d={smooth(all.slice(0, reach + 1))} fill="none" stroke="var(--teal)" stroke-width="4" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>}
  </svg>
  <ol class="road-nodes">
    {steps.map((s, i) => {
      const p = pts[i], right = p.x >= W / 2;
      const kind = i === cur ? 'is-now' : s.state === 'completed' ? 'is-done' : '';
      return (
        <li class={`rn ${kind} ${right ? 'lbl-left' : 'lbl-right'}`} style={`top:${p.y}px;--x:${pct(p.x)}`}>
          <a href={`${hrefBase}/${s.id}`}>
            <span class="dot">{s.state === 'completed' && i !== cur ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg> : s.position}</span>
            <span class="lbl">{i === cur && <span class="today">اليوم</span>}<span class="t">{s.title}</span><span class="sr-only">{s.state === 'completed' ? ' (مكتملة)' : s.state === 'in_progress' ? ' (بدأتها)' : ''}</span></span>
          </a>
        </li>
      );
    })}
  </ol>
  <div class="road-end" style={`top:${end.y}px;--x:${pct(end.x)}`} aria-hidden="true">
    <svg viewBox="0 0 40 40"><circle cx="20" cy="22" r="9" fill="var(--gold)" opacity={cur < 0 ? 1 : .45}></circle><path d="M20 4v5M7 10l3 3M33 10l-3 3" stroke="var(--gold)" stroke-width="2.4" stroke-linecap="round" opacity={cur < 0 ? 1 : .45}></path></svg>
    <span>النهاية</span>
  </div>
</div>
