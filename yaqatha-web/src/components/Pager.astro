---
interface Props { page: number; pages: number; base: string; params?: Record<string, string | undefined> }
const { page, pages, base, params = {} } = Astro.props;
const href = (p: number) => {
  const u = new URLSearchParams();
  for (const [k, v] of Object.entries(params)) if (v) u.set(k, v);
  if (p > 1) u.set('page', String(p));
  const s = u.toString();
  return s ? `${base}?${s}` : base;
};
---
{pages > 1 && (
  <nav class="pager" aria-label="الصفحات">
    {page > 1 ? <a href={href(page - 1)} rel="prev">السابق</a> : <span class="off">السابق</span>}
    <span>صفحة {page} من {pages}</span>
    {page < pages ? <a href={href(page + 1)} rel="next">التالي</a> : <span class="off">التالي</span>}
  </nav>
)}
