---
// قوس «أحسنت»: الشمس تتقدّم على الأفق من موضعها قبل هذه الخطوة إلى موضعها الآن (يبدأ من اليمين).
import { pointAt, r1 } from '../lib/arc';
interface Props { from: number; to: number; total: number }
const { from, to, total } = Astro.props;
const f0 = total ? Math.max(0, from / total) : 0, f1 = total ? Math.min(1, to / total) : 0;
const A = { x: 296, y: 100 }, C = { x: 155, y: -24 }, B = { x: 14, y: 100 };
const d = `M${A.x} ${A.y} Q${C.x} ${C.y} ${B.x} ${B.y}`;
const p0 = pointAt(A, C, B, f0), p1 = pointAt(A, C, B, f1);
const kp = (f: number) => r1(f).toFixed(1);
---
<svg viewBox="0 0 310 112" class="done-arc" role="img" aria-label={`أكملت ${to} من ${total}`}>
  <line x1="0" y1="100" x2="310" y2="100" stroke="var(--track)"></line>
  <path d={d} fill="none" stroke="var(--line-strong)" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round"></path>
  <path d={d} fill="none" stroke="var(--teal)" stroke-width="4" stroke-linecap="round" pathLength="100" stroke-dasharray={`${r1(f1 * 100)} 100`}>
    <animate attributeName="stroke-dasharray" from={`${r1(f0 * 100)} 100`} to={`${r1(f1 * 100)} 100`} dur="1.1s" begin="0.25s" fill="freeze" calcMode="spline" keySplines="0.3 0 0.2 1" keyTimes="0;1" data-motion></animate>
  </path>
  <g transform={`translate(${r1(p1.x)} ${r1(p1.y)})`} data-sun>
    <animateTransform attributeName="transform" type="translate" values={Array.from({ length: 13 }, (_, i) => { const q = pointAt(A, C, B, f0 + ((f1 - f0) * i) / 12); return `${r1(q.x)} ${r1(q.y)}`; }).join(';')} dur="1.1s" begin="0.25s" fill="freeze" data-motion></animateTransform>
    <circle r="18" fill="var(--gold)"></circle>
    <path d="M-8 0l6 6 11-12" fill="none" stroke="var(--on-gold)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
</svg>
<script>
  // من طلب تقليل الحركة: تظهر الشمس في موضعها الأخير مباشرة
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('[data-motion]').forEach((a) => a.remove());
</script>
