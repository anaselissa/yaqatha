---
interface Props { href: string; label?: string; close?: boolean }
const { href, label, close = false } = Astro.props;
---
<a class="back-btn" href={href} aria-label={label ?? (close ? 'إغلاق' : 'رجوع')}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{close ? <path d="M6 6l12 12M18 6L6 18"></path> : <path d="M9 6l6 6-6 6"></path>}</svg>
</a>
