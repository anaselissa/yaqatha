---
import Sun from './Sun.astro';
import { SITE } from '../config';
interface Props { streak?: number | null }
const { streak } = Astro.props;
const s = Astro.locals.session;
const p = Astro.url.pathname;
// الحرف الأول من الاسم (أو البريد) ليعرف المستخدم أنه داخل، في كل صفحة
const initial = s ? ((s.name || s.email || '؟').trim().charAt(0) || '؟') : '';
const next = p === '/' ? '/journey' : p;
---
<header class="site-header">
  <div class="app-col bar">
    <a class="brand" href="/" aria-label={`${SITE.name}: الرئيسية`}><Sun />يقظة</a>
    <div class="who">
      {s && streak ? (
        <span class="streak" title="أيام متتالية">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3c2 4 6 5 6 10a6 6 0 0 1-12 0c0-3 2-4 2-7 2 1 3 3 4 3 0-2-1-4 0-6z"></path></svg>
          {streak === 1 ? 'يوم واحد' : streak === 2 ? 'يومان' : `${streak} ${streak <= 10 ? 'أيام' : 'يومًا'}`}
        </span>
      ) : null}
      {s
        ? <a class="avatar" href="/account" aria-label="حسابي (أنت مسجّل الدخول)" data-signed-in>{initial}</a>
        : <a class="signin" href={`/login?next=${encodeURIComponent(next)}`}>دخول</a>}
    </div>
  </div>
</header>
