---
import { durationLabel, stepsLabel } from '../lib/labels';
import LevelPill from './LevelPill.astro';
import type { PathCard } from '../lib/data';
interface Props { path: PathCard }
const { path } = Astro.props;
---
<a class="path-card" href={`/paths/${path.slug}`}>
  <h3>{path.title}</h3>
  {path.description && <p>{path.description}</p>}
  <div class="meta">
    <LevelPill level={path.level} />
    <span class="chip chip-gold">{durationLabel(path.duration_days)}</span>
    {path.steps_count ? <span class="chip">{stepsLabel(path.steps_count)}</span> : null}
  </div>
</a>
