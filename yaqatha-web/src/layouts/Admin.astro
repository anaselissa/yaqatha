---
import Base from './Base.astro';
interface Props { title: string }
const { title } = Astro.props;
const p = Astro.url.pathname;
const role = Astro.locals.staffRole;
const tabs = [['/admin', 'الرئيسية'], ['/admin/materials', 'المواد'], ['/admin/taxonomy', 'الاحتياجات والمجالات']];
const cur = (h: string) => (h === '/admin' ? p === '/admin' : p === h || p.startsWith(h + '/'));
---
<Base title={`${title} — الإدارة`} noindex>
  <div class="container admin">
    <header class="page-head">
      <p class="row" style="gap:.5rem; margin:0">
        <span class="chip chip-gold">لوحة الإدارة</span>
        <span class="chip">{role === 'manager' ? 'مدير' : 'محرر محتوى'}</span>
      </p>
      <h1>{title}</h1>
      <nav class="filters" aria-label="أقسام الإدارة" style="margin-top:1rem">
        {tabs.map(([h, l]) => <a href={h} aria-current={cur(h) ? 'true' : undefined}>{l}</a>)}
      </nav>
    </header>
    <div style="padding-block:1rem 3rem"><slot /></div>
  </div>
</Base>
