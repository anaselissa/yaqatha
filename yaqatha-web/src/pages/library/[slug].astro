---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NeedList from '../../components/NeedList.astro';
import ErrorState from '../../components/ErrorState.astro';
import { getMaterial, getMaterialQuestions, getMaterialRelations, getMaterialSeries, resolveRedirect } from '../../lib/data';
import { MATERIAL_TYPE, NATURE, formatDate } from '../../lib/labels';
import { renderMarkdown, youtubeId } from '../../lib/markdown';
import { FEATURES } from '../../config';
import { load } from '../../lib/page';

const slug = Astro.params.slug!;
const data = await load(Astro.response, async () => {
  const material = await getMaterial(slug);
  if (!material) return { material: null, redirect: await resolveRedirect('material', slug) };
  const [rel, series, questions] = await Promise.all([getMaterialRelations(material.id), getMaterialSeries(material.id), getMaterialQuestions(material.id)]);
  return { material, redirect: null, rel, series, questions };
});
if (data && !data.material) {
  if (data.redirect) return Astro.redirect(`/library/${data.redirect}`, 301);
  return Astro.rewrite('/404');
}
const m = data?.material;
const rel = data && 'rel' in data ? data.rel : null;
const sr = data && 'series' in data ? data.series : null;
const questions = data && 'questions' in data ? data.questions : [];
const [qaId, qaIdx] = (Astro.url.searchParams.get('qa') ?? '').split('.');
const answered = (id: string) => (qaId === id && /^\d$/.test(qaIdx ?? '') ? Number(qaIdx) : null);
const html = m ? renderMarkdown(m.body) : '';
const yt = m?.type === 'video' ? youtubeId(m.url) : null;
const ld = m && (m.type === 'article' || m.type === 'guidance') ? {
  '@context': 'https://schema.org', '@type': 'Article', headline: m.title, inLanguage: 'ar',
  description: m.description ?? undefined, dateModified: m.updated_at,
  ...(m.author ? { author: { '@type': 'Person', name: m.author } } : {}),
} : undefined;
---
<Base title={m?.title} description={m?.description ?? undefined} type="article" jsonLd={ld}>
  {!data || !m || !rel ? <ErrorState /> : (
    <div class="container">
      <header class="page-head">
        <Breadcrumbs items={[{ label: 'الرئيسية', href: '/' }, { label: 'المواد والمحتوى', href: '/library' }, { label: m.title }]} />
        <div class="meta" style="margin-bottom:0.9rem">
          {sr && <a class="chip chip-gold" href={`/series/${sr.slug}`}>{sr.title} · الحلقة {sr.index} من {sr.total}</a>}
          <span class="chip chip-gold">{MATERIAL_TYPE[m.type] ?? m.type}</span>
          <span class="chip">{NATURE[m.nature]}</span>
        </div>
        <h1>{m.title}</h1>
        {m.description && <p class="lead">{m.description}</p>}
      </header>

      <div class="stack" style="--space:2rem; padding-block: 1rem 2rem">
        {yt && (
          <div class="video-shell" data-yt={yt}>
            <button type="button" aria-label="تشغيل الفيديو">
              <span class="play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
              <span>تشغيل الفيديو</span>
            </button>
          </div>
        )}
        {yt && <p class="faint" style="font-size:0.9rem; max-width:var(--measure)">لا يُحمَّل الفيديو من الخارج إلا حين تنقر التشغيل، حفاظًا على خصوصيتك وسرعة الصفحة.</p>}
        {!yt && m.url && <p><a class="btn btn-primary" href={m.url} target="_blank" rel="noopener nofollow">افتح المصدر ↗</a></p>}
        {html && <div class="prose" set:html={html} />}

        {questions.length > 0 && (
          <section class="quiz" aria-labelledby="quiz-h">
            <h2 id="quiz-h" style="font-size:1.5rem">اختبر فهمك</h2>
            {questions.map((q, n) => {
              const a = answered(q.id);
              return (
                <form id={`q-${q.id}`} method="post" action="/api/quiz" class="quiz-q">
                  <input type="hidden" name="slug" value={m.slug} />
                  <input type="hidden" name="question_id" value={q.id} />
                  <fieldset>
                    <legend><span class="gold">{n + 1}.</span> {q.prompt}</legend>
                    {q.options.map((o, i) => (
                      <label class={a === null ? '' : i === q.correct_index ? 'is-right' : i === a ? 'is-wrong' : ''}>
                        <input type="radio" name="choice" value={i} required checked={a === i} />{o}
                      </label>
                    ))}
                  </fieldset>
                  {a === null ? <button class="btn btn-ghost btn-sm" type="submit">تحقّق</button> : (
                    <div class="notice" role="status">
                      <strong>{a === q.correct_index ? 'إجابة صحيحة، بارك الله فيك.' : 'ليست هذه. الصحيحة مظلّلة أعلاه.'}</strong>
                      {q.explanation && <p style="margin:.3rem 0 0">{q.explanation}</p>}
                    </div>
                  )}
                </form>
              );
            })}
          </section>
        )}

        {sr && (sr.prev || sr.next) && (
          <nav class="series-nav" aria-label={`حلقات ${sr.title}`}>
            {sr.next && <a class="btn btn-primary" href={`/library/${sr.next.slug}`} rel="next">الحلقة التالية: {sr.next.title}</a>}
            {sr.prev && <a class="btn btn-ghost btn-sm" href={`/library/${sr.prev.slug}`} rel="prev">السابقة</a>}
            <a class="btn btn-ghost btn-sm" href={`/series/${sr.slug}`}>كل الحلقات</a>
          </nav>
        )}

        <dl class="source-box">
          {(m.source_title || m.source_url) && (<><dt>المصدر الأصلي</dt><dd>{m.source_url ? <a href={m.source_url} target="_blank" rel="noopener nofollow">{m.source_title ?? m.source_url}</a> : m.source_title}</dd></>)}
          {m.author && (<><dt>{m.type === 'video' ? 'المحاضر' : 'المؤلف'}</dt><dd>{m.author}</dd></>)}
          <dt>طبيعة المادة</dt><dd>{NATURE[m.nature]}</dd>
          <dt>آخر تحديث</dt><dd>{formatDate(m.updated_at)}</dd>
        </dl>
      </div>

      {FEATURES.accounts && (
        <section class="section" style="padding-block-start:0" aria-label="إجراءات المادة">
          <div class="row">
            <form method="post" action="/api/save-material" data-material-state={m.id}>
              <input type="hidden" name="material_id" value={m.id} />
              <input type="hidden" name="next" value={`/library/${m.slug}`} />
              <button class="btn btn-primary btn-sm" type="submit">احفظ للرجوع إليها</button>
            </form>
          </div>
          <details class="fold" style="margin-top:1rem; max-width:var(--measure)"><summary>أبلغ عن مشكلة في هذه المادة</summary>
            <form method="post" action="/api/report-material" class="stack" style="--space:.8rem; margin-top:1rem">
              <input type="hidden" name="material_id" value={m.id} />
              <input type="hidden" name="next" value={`/library/${m.slug}`} />
              <div class="field"><label for="note">ما المشكلة؟ (رابط لا يعمل، خطأ في المحتوى…)</label><textarea id="note" name="note" maxlength="1000" required></textarea></div>
              <div><button class="btn btn-ghost btn-sm" type="submit">أرسل البلاغ</button></div>
            </form>
          </details>
        </section>
      )}

      {rel.needs.length > 0 && (
        <section class="section" style="padding-block-start:1rem">
          <div class="section-title"><h2>احتياجات ترتبط بهذه المادة</h2></div>
          <NeedList needs={rel.needs} />
        </section>
      )}
      {rel.topics.length > 0 && (
        <section class="section" style="padding-block-start:0">
          <h2 class="section-title" style="font-size:1.4rem; color:var(--dim)">موضوعات</h2>
          <div class="filters">{rel.topics.map((t) => <a href={`/topics/${t.slug}`}>{t.title}</a>)}</div>
        </section>
      )}
    </div>
  )}
</Base>
<script>
  // تحميل الفيديو بالنقر فقط (youtube-nocookie)
  document.querySelectorAll<HTMLElement>('.video-shell[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const id = box.dataset.yt;
      if (!id || !/^[\w-]{6,20}$/.test(id)) return;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = 'مشغّل الفيديو';
      f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(f);
    });
  });
</script>
