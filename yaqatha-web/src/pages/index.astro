---
import Base from '../layouts/Base.astro';
import Star from '../components/Star.astro';
import PathCard from '../components/PathCard.astro';
import MaterialList from '../components/MaterialList.astro';
import ErrorState from '../components/ErrorState.astro';
import { getDoors, getHomepage } from '../lib/data';
import { load } from '../lib/page';
import { SITE } from '../config';

const data = await load(Astro.response, async () => {
  const [doors, home] = await Promise.all([getDoors(), getHomepage()]);
  return { doors, home };
});
const site = Astro.site!.toString().replace(/\/$/, '');
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: SITE.nameSearch, url: site, inLanguage: 'ar',
    potentialAction: { '@type': 'SearchAction', target: `${site}/search?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: site, description: SITE.description },
];
---
<Base canonical="/" jsonLd={ld}>
  {!data ? <ErrorState /> : (
    <>
      <section class="hero">
        <div class="container">
          <h1>من الغفلة… إلى اليقظة</h1>
          <p class="lead">مسارات عملية بخطوات يومية قصيرة وواضحة، ومصادر موثوقة.</p>
          <div class="actions">
            <a class="btn btn-primary" href="/start">لا أعرف من أين أبدأ</a>
            <a class="btn btn-ghost" href="/discover">اكتشف احتياجك</a>
          </div>
          <p class="mt-1_2"><a href="/journey/goals/new" class="dim">أو أنشئ هدفك بنفسك مباشرة</a></p>
        </div>
      </section>
      <hr class="horizon" />

      <section class="section" aria-labelledby="doors-h">
        <div class="container">
          <div class="section-title"><h2 id="doors-h">أربعة أبواب</h2></div>
          <div class="doors">
            {data.doors.map((d, i) => (
              <a class="door" href={`/doors/${d.slug}`}>
                <span class="num"><Star />{['الأول', 'الثاني', 'الثالث', 'الرابع'][i] ?? ''}</span>
                <h3>{d.title}</h3>
                {d.description && <p>{d.description}</p>}
                <span class="go">ادخل هذا الباب</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      {data.home.startHere.length > 0 && (
        <section class="section section-flush" aria-labelledby="start-h">
          <div class="container">
            <div class="section-title"><h2 id="start-h">ابدأ من هنا</h2><a href="/paths">كل المسارات</a></div>
            <div class="grid grid-2">{data.home.startHere.map((p) => <PathCard path={p} />)}</div>
          </div>
        </section>
      )}
      {data.home.featuredPaths.length > 0 && (
        <section class="section section-flush" aria-labelledby="fp-h">
          <div class="container">
            <div class="section-title"><h2 id="fp-h">مسارات مختارة</h2><a href="/paths">كل المسارات</a></div>
            <div class="grid grid-2">{data.home.featuredPaths.map((p) => <PathCard path={p} />)}</div>
          </div>
        </section>
      )}
      {data.home.featuredMaterials.length > 0 && (
        <section class="section section-flush" aria-labelledby="fm-h">
          <div class="container narrow maxw-70">
            <div class="section-title"><h2 id="fm-h">مواد مختارة</h2><a href="/library">كل المواد</a></div>
            <MaterialList items={data.home.featuredMaterials} />
          </div>
        </section>
      )}

      <section class="section section-flush" aria-labelledby="values-h">
        <div class="container">
          <div class="divider mb-2"><Star /></div>
          <h2 id="values-h" class="sr-only">ما الذي ستجده هنا</h2>
          <div class="values">
            <div><h3>مسارات عملية</h3><p>خطوات مرتّبة تنقلك من المعرفة إلى التطبيق، لا مجرد محاضرات تُشاهد.</p></div>
            <div><h3>مواد بمصادرها</h3><p>لكل مادة مصدرها الأصلي، ونميّز بين المادة الأصلية وما أعدّه فريق يقظة.</p></div>
            <div><h3>بلا حساب</h3><p>تصفّح كل شيء مباشرة، والحساب اختياري لحفظ تقدمك. ولا اختبارات تقيس إيمانك أو تقارنك بغيرك.</p></div>
          </div>
        </div>
      </section>
    </>
  )}
</Base>
