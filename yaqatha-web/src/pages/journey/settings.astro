---
import Base from '../../layouts/Base.astro';
import BackBtn from '../../components/BackBtn.astro';
import AppTools from '../../components/AppTools.astro';
import { ROLE, getStaffRole } from '../../lib/admin';
import { rest } from '../../lib/api';
const s = Astro.locals.session!;
const [role, req] = await Promise.all([
  getStaffRole(s.token, s.userId).catch(() => null),
  // مشاركة التقدّم مع المشرف (الهجرة 13): تظهر فقط لمن عنده طلب متابعة مفتوح
  rest<{ id: string; share_progress: boolean }>('mentorship_requests', { select: 'id,share_progress', status: 'neq.closed', limit: 1 }, { token: s.token }).then((r) => r.rows[0] ?? null).catch(() => null),
]);
---
<Base title="الإعدادات" noindex>
  <div class="app-col screen">
    <div class="screen-head"><BackBtn href="/account" label="رجوع إلى حسابي" /><h1>الإعدادات</h1></div>

    <section class="set-sec" id="reminder" aria-labelledby="rem-h">
      <h2 id="rem-h">التذكير اليومي والتطبيق</h2>
      <AppTools compact />
    </section>

    <section class="set-sec" aria-labelledby="look-h">
      <h2 id="look-h">المظهر</h2>
      <div class="theme-pick" role="group" aria-label="المظهر" data-theme-pick>
        <button type="button" data-v="dark" aria-pressed="true">داكن</button>
        <button type="button" data-v="light" aria-pressed="false">فاتح</button>
        <button type="button" data-v="auto" aria-pressed="false">حسب الجهاز</button>
      </div>
    </section>

    <section class="set-sec" aria-labelledby="acc-h">
      <h2 id="acc-h">الحساب والخصوصية</h2>
      <div class="card">
        <p>{s.name ? `${s.name}، ` : ''}<span dir="ltr">{s.email}</span></p>
        <p class="faint fs-0_9">يأتي الاسم والبريد من حساب Google، ولا نخزّن غيرهما عنك سوى أهدافك وتقدمك ومحفوظاتك.</p>
        {req && (
          <form method="post" action="/api/share-progress" class="row">
            <input type="hidden" name="on" value={req.share_progress ? '0' : '1'} /><input type="hidden" name="next" value="/journey/settings" />
            <span class="grow-col">مشرفي يرى تقدّمي في مساراتي<span class="faint fs-0_85">{req.share_progress ? 'مفعّل' : 'متوقف'}</span></span>
            <button class="btn btn-ghost btn-sm" type="submit">{req.share_progress ? 'أوقف المشاركة' : 'شاركه'}</button>
          </form>
        )}
        <form method="post" action="/auth/logout"><button class="btn btn-ghost btn-sm" type="submit">تسجيل الخروج</button></form>
      </div>
      {role && <a class="row-link card-link" href="/admin"><span class="grow"><span class="t">لوحة الإدارة</span><span class="s">أنت {ROLE[role]} في الفريق</span></span></a>}
      <details class="fold"><summary class="danger-text">حذف الحساب والبيانات</summary>
        <div class="stack sp-0_9 mt-1">
          <p>سيُحذف حسابك وكل ما يتصل به نهائيًا: أهدافك، ومساراتك وتقدمك، ومحفوظاتك. لا يمكن التراجع عن ذلك. أما المحتوى العام للموقع فلا يتأثر.</p>
          <form method="post" action="/api/delete-account" class="stack sp-0_8">
            <input type="hidden" name="next" value="/journey/settings" />
            <div class="field"><label for="confirm">للتأكيد اكتب: احذف</label><input id="confirm" name="confirm" type="text" autocomplete="off" required /></div>
            <div><button class="btn btn-danger" type="submit">احذف حسابي وبياناتي</button></div>
          </form>
        </div>
      </details>
    </section>
  </div>
</Base>
