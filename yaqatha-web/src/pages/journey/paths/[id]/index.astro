---
import Base from '../../../../layouts/Base.astro';
import JourneyNav from '../../../../components/JourneyNav.astro';
import ErrorState from '../../../../components/ErrorState.astro';
import Progress from '../../../../components/Progress.astro';
import StepControls from '../../../../components/StepControls.astro';
import PostButton from '../../../../components/PostButton.astro';
import { getEnrollment, getEnrollmentSteps, getGoals, getLatestVersions, getPathEnding, getProgress, planMigration } from '../../../../lib/user';
import { rest } from '../../../../lib/api';
import { STEP_TYPE, durationLabel } from '../../../../lib/labels';
import { load } from '../../../../lib/page';

const id = Astro.params.id!;
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.rewrite('/404');
const t = Astro.locals.session!.token;
const wantMigrate = Astro.url.searchParams.get('migrate') === '1';
const isNew = Astro.url.searchParams.get('new') === '1';

const data = await load(Astro.response, async () => {
  const e = await getEnrollment(t, id);
  if (!e) return { e: null };
  const [{ steps, state }, prog, latest, goals, linked] = await Promise.all([
    getEnrollmentSteps(t, e), getProgress(t, [e.id]), getLatestVersions([e.path_id]), getGoals(t, ['not_started', 'in_progress', 'paused']),
    rest<{ goal_id: string; goals: { id: string; title: string } | null }>('goal_enrollments', { select: 'goal_id,goals(id,title)', enrollment_id: `eq.${e.id}` }, { token: t }).then((r) => r.rows),
  ]);
  const newer = latest.get(e.path_id);
  const hasUpdate = e.status === 'active' && !!newer && !!e.path_versions && newer.version_no > e.path_versions.version_no;
  const plan = hasUpdate && wantMigrate ? await planMigration(t, e.id) : null;
  const p = prog.get(e.id);
  const done = !!p && p.total_steps > 0 && p.completed_steps === p.total_steps;
  const ending = done ? await getPathEnding(t, e.path_id) : null;
  return { e, steps, state, prog: p, newer, hasUpdate, plan, goals, linked, done, ending };
});
if (data && !data.e) return Astro.rewrite('/404');
const d = data && data.e ? data : null;
const e = d?.e;
const here = `/journey/paths/${id}`;
const withdrawn = e?.path_versions?.status === 'withdrawn';
const active = e?.status === 'active';
const linkedTitles = new Set(d?.linked.map((l) => l.goals?.title));
const KIND: Record<string, string> = { carried: 'سيُنقل تقدمها', new: 'خطوة جديدة', removed: 'لن تظهر في الإصدار الجديد (تبقى في سجل إصدارك)' };
---
<Base title={e?.path_versions?.title ?? 'مسار'} noindex>
  {!d || !e ? <ErrorState /> : (
    <div class="container">
      <header class="page-head">
        <h1>{e.path_versions?.title}</h1>
        <div class="meta mt-0_8">
          <span class="chip">الإصدار {e.path_versions?.version_no}</span>
          <span class="chip chip-gold">{durationLabel(e.path_versions?.duration_days)}</span>
          {!active && <span class="chip">مؤرشف</span>}
        </div>
        <JourneyNav />
      </header>

      <div class="stack sp-1_2 py-1">
        {isNew && active && (
          <div class="notice">
            <strong>هل تريد ربط هذا المسار بهدف؟</strong> اختياري تمامًا.
            <div class="row mt-0_8">
              {d.goals.length > 0 && (
                <form method="post" action="/api/goal-link" class="row">
                  <input type="hidden" name="enrollment_id" value={e.id} /><input type="hidden" name="next" value={here} />
                  <label class="sr-only" for="goal_id">هدف</label>
                  <select id="goal_id" name="goal_id" class="input w-auto">{d.goals.map((g) => <option value={g.id}>{g.title}</option>)}</select>
                  <button class="btn btn-ghost btn-sm" type="submit">اربطه</button>
                </form>
              )}
              <a class="btn btn-ghost btn-sm" href={`/journey/goals/new?enrollment=${e.id}&title=${encodeURIComponent(e.path_versions?.title ?? '')}`}>أنشئ هدفًا جديدًا منه</a>
              <a class="btn btn-ghost btn-sm" href={here}>ليس الآن</a>
            </div>
          </div>
        )}

        {withdrawn && (
          <div class="notice" role="alert"><strong>سُحب هذا الإصدار مؤقتًا للمراجعة.</strong> تقدمك محفوظ ولم يضِع منه شيء، وسيتاح المحتوى حين تنتهي المراجعة{d.hasUpdate ? ' أو يمكنك الانتقال إلى الإصدار المحدَّث أدناه' : ''}.</div>
        )}

        {d.hasUpdate && !wantMigrate && (
          <div class="notice">
            <strong>يتوفر إصدار محدَّث من هذا المسار (الإصدار {d.newer!.version_no}).</strong> لن يتغير شيء في مسارك ما لم تنتقل أنت.
            <div class="row mt-0_8"><a class="btn btn-ghost btn-sm" href={`${here}?migrate=1`}>اطّلع على الجديد</a></div>
          </div>
        )}

        {d.plan && (
          <section class="journey-card" aria-labelledby="mig-h">
            <h2 class="fs-1_6" id="mig-h">الانتقال إلى الإصدار {d.newer!.version_no}</h2>
            {d.newer!.description && <p class="dim">{d.newer!.description}</p>}
            <ul class="diff list-none p-0 m-0">
              {d.plan.map((p) => <li><span class="chip me-0_5">{KIND[p.kind]}</span>{p.title}</li>)}
            </ul>
            <p class="faint fs-0_95">يُؤرشف إصدارك الحالي بتقدمه ويبقى للاطلاع، ولا يُحذف شيء.</p>
            <div class="row">
              <PostButton action="migrate" fields={{ enrollment_id: e.id }} label="انتقل إلى الإصدار الجديد" kind="primary" small={false} />
              <a class="btn btn-ghost" href={here}>أبقَ على إصداري</a>
            </div>
          </section>
        )}

        {d.prog && !withdrawn && <Progress done={d.prog.completed_steps} total={d.prog.total_steps} />}
        {d.linked.length > 0 && (
          <p class="dim">مرتبط بالأهداف: {d.linked.map((l, i) => <>{i > 0 && '، '}{l.goals ? <a href={`/journey/goals/${l.goals.id}`}>{l.goals.title}</a> : null}</>)}</p>
        )}
      </div>

      {!withdrawn && (
        <section class="section section-flush" aria-labelledby="steps-h">
          <div class="section-title"><h2 id="steps-h">الخطوات</h2></div>
          {d.steps.map((s) => (
            <div class="step-row">
              <div class="meta"><span class="chip chip-gold">{STEP_TYPE[s.type]}</span></div>
              <h3><a href={`/journey/paths/${e.id}/steps/${s.id}`}>{s.position}. {s.title}</a></h3>
              <StepControls enrollmentId={e.id} stepId={s.id} state={d.state(s.id)} next={here} readonly={!active} />
            </div>
          ))}
          {d.done && (
            <section id="ending" class="journey-card mt-1_5" aria-labelledby="end-h">
              <h2 class="fs-1_6" id="end-h">أتممت خطوات المسار</h2>
              <p class="dim">أنهيت {d.prog!.total_steps} خطوات. هذا تسجيل شخصي منك ولا يحكم على أثره في حياتك؛ الأثر الحقيقي فيما تستمر عليه بعده.</p>

              {active && (
                <div class="stack sp-0_7">
                  <h3 class="fs-1_25">حوّله إلى عادة</h3>
                  {d.ending!.goals.map((g) => (
                    <div class="notice">
                      <strong>{g.title}</strong>
                      {g.description && <p class="m-0_3-0-0">{g.description}</p>}
                      <div class="mt-0_7">
                        {linkedTitles.has(g.title) ? <span class="chip chip-gold">صار هدفك ✓</span> : (
                          <form method="post" action="/api/goal-create">
                            <input type="hidden" name="id" value={crypto.randomUUID()} />
                            <input type="hidden" name="title" value={g.title} />
                            <input type="hidden" name="description" value={g.description ?? ''} />
                            <input type="hidden" name="enrollment_id" value={e.id} />
                            <button class="btn btn-primary btn-sm" type="submit">اجعله هدفي</button>
                          </form>
                        )}
                      </div>
                    </div>
                  ))}
                  <p><a class="btn btn-ghost btn-sm" href={`/journey/goals/new?enrollment=${e.id}`}>اكتب هدفك أنت</a></p>
                </div>
              )}

              {d.ending!.paths.length > 0 && (
                <div class="stack sp-0_7 mt-1_2">
                  <h3 class="fs-1_25">خطوتك التالية</h3>
                  {d.ending!.paths.map((p) => (
                    <a class="path-card" href={`/paths/${p.slug}`}>
                      <h4 class="m-0 fs-1_15">{p.title}</h4>
                      {p.description && <p class="dim m-0_3-0-0">{p.description}</p>}
                      <div class="meta"><span class="chip chip-gold">{durationLabel(p.duration_days)}</span></div>
                    </a>
                  ))}
                </div>
              )}
              {d.ending!.paths.length === 0 && <p class="mt-1">تصفّح <a href="/paths">المسارات</a> لتختار خطوتك التالية.</p>}
              <p class="dim mt-1">تحب أن يتابع معك أحد من فريق يقظة على ما بدأت؟ <a href="/support">اطلب متابعة</a></p>
            </section>
          )}
        </section>
      )}

      {active && (
        <section class="section section-flush">
          <details class="fold"><summary>خيارات المسار</summary>
            <div class="stack sp-0_8 mt-1">
              <div class="row"><PostButton action="restart" fields={{ enrollment_id: e.id }} label="ابدأ من جديد" /><span class="faint">يُؤرشف تقدمك الحالي ويبدأ مسار جديد على آخر إصدار.</span></div>
              <div class="row"><PostButton action="archive-enrollment" fields={{ enrollment_id: e.id }} label="أخفِ من رحلتي" /><span class="faint">يُحفظ في الأرشيف ولا يُحذف.</span></div>
            </div>
          </details>
        </section>
      )}
    </div>
  )}
</Base>
