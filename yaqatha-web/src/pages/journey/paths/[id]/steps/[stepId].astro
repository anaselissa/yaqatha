---
import Base from '../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import ErrorState from '../../../../../components/ErrorState.astro';
import StepControls from '../../../../../components/StepControls.astro';
import { getEnrollment, getEnrollmentSteps } from '../../../../../lib/user';
import { rpc } from '../../../../../lib/api';
import { MATERIAL_TYPE, STEP_TYPE } from '../../../../../lib/labels';
import { load } from '../../../../../lib/page';

const { id, stepId } = Astro.params;
if (!/^[0-9a-f-]{36}$/i.test(id!) || !/^[0-9a-f-]{36}$/i.test(stepId!)) return Astro.rewrite('/404');
const t = Astro.locals.session!.token;
const data = await load(Astro.response, async () => {
  const e = await getEnrollment(t, id!);
  if (!e) return null;
  const r = await getEnrollmentSteps(t, e);
  const step = r.steps.find((s) => s.id === stepId);
  // فتح الخطوة يحدّث «آخر خطوة» لتعود إليها (لا يغيّر حالتها)
  if (step && e.status === 'active') await rpc('mark_step_opened', { p_enrollment_id: e.id, p_step_id: step.id }, t).catch(() => null);
  return { e, step, steps: r.steps, state: r.state };
});
if (data === null && Astro.response.status !== 503) return Astro.rewrite('/404');
if (data && !data.step) return Astro.rewrite('/404');
const e = data?.e, step = data?.step;
const idx = data && step ? data.steps.findIndex((s) => s.id === step.id) : -1;
const prev = data?.steps[idx - 1], next = data?.steps[idx + 1];
const here = `/journey/paths/${id}/steps/${stepId}`;
---
<Base title={step?.title} noindex>
  {!data || !e || !step ? <ErrorState /> : (
    <div class="container narrow">
      <header class="page-head">
        <Breadcrumbs items={[{ label: 'رحلتي', href: '/journey' }, { label: e.path_versions?.title ?? 'مسار', href: `/journey/paths/${e.id}` }, { label: `الخطوة ${step.position}` }]} />
        <div class="meta mb-0_8"><span class="chip chip-gold">{STEP_TYPE[step.type]}</span><span class="chip">الخطوة {step.position} من {data.steps.length}</span></div>
        <h1>{step.title}</h1>
      </header>
      <div class="stack sp-1_5 py-1-2">
        {step.instructions && <p class="prose fs-1_3">{step.instructions}</p>}
        {step.step_materials.length > 0 && (
          <div>
            <h2 class="fs-1_4 mb-0_8">المواد المرتبطة</h2>
            <ul class="mats">{step.step_materials.map((sm) => sm.materials
              ? <li><a class="mat" href={`/library/${sm.materials.slug}`}><div class="meta"><span class="chip chip-gold">{MATERIAL_TYPE[sm.materials.type]}</span></div><h3>{sm.materials.title}</h3>{sm.materials.description && <p>{sm.materials.description}</p>}</a></li>
              : <li class="mat unavailable">هذه المادة غير متاحة حاليًا</li>)}</ul>
          </div>
        )}
        <StepControls enrollmentId={e.id} stepId={step.id} state={data.state(step.id)} next={here} readonly={e.status !== 'active'} />
      </div>
      <nav class="pager pb-2" aria-label="التنقل بين الخطوات">
        {prev ? <a href={`/journey/paths/${e.id}/steps/${prev.id}`} rel="prev">الخطوة السابقة</a> : <span class="off">الخطوة السابقة</span>}
        <a href={`/journey/paths/${e.id}`}>كل الخطوات</a>
        {next ? <a href={`/journey/paths/${e.id}/steps/${next.id}`} rel="next">الخطوة التالية</a> : <span class="off">الخطوة التالية</span>}
      </nav>
    </div>
  )}
</Base>
