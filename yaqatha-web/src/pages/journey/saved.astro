---
import Base from '../../layouts/Base.astro';
import JourneyNav from '../../components/JourneyNav.astro';
import ErrorState from '../../components/ErrorState.astro';
import PostButton from '../../components/PostButton.astro';
import { getSaved } from '../../lib/user';
import { MATERIAL_TYPE } from '../../lib/labels';
import { load } from '../../lib/page';
const saved = await load(Astro.response, () => getSaved(Astro.locals.session!.token));
---
<Base title="المحفوظات" noindex>
  {!saved ? <ErrorState /> : (
    <div class="container">
      <header class="page-head"><h1>المحفوظات</h1><JourneyNav /></header>
      <section class="section pbs-1">
        {saved.length ? (
          <ul class="mats">{saved.map((s) => (
            <li class="py-0_4">
              {s.materials ? (
                <div class="row justify-between items-start">
                  <a class="mat flex-1" href={`/library/${s.materials.slug}`}><div class="meta"><span class="chip chip-gold">{MATERIAL_TYPE[s.materials.type]}</span></div><h3>{s.materials.title}</h3></a>
                  <PostButton action="unsave-material" fields={{ material_id: s.material_id }} label="إزالة" />
                </div>
              ) : (
                <div class="row justify-between"><span class="unavailable">هذه المادة غير متاحة حاليًا</span>
                  <PostButton action="unsave-material" fields={{ material_id: s.material_id }} label="إزالة" /></div>
              )}
            </li>))}</ul>
        ) : (
          <div class="empty"><h2>لم تحفظ مادة بعد</h2><p>احفظ ما تريد الرجوع إليه من صفحة أي مادة.</p><div class="actions"><a class="btn btn-primary" href="/library">تصفّح المواد</a></div></div>
        )}
      </section>
    </div>
  )}
</Base>
