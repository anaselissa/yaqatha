---
// رحلتي: مساراتي الآن، وعاداتي اليومية، وما أنجزت. المسار الذي لم يُفتح 7 أيام يظهر في «متوقفة» ويعود بضغطة.
import Base from '../../layouts/Base.astro';
import ErrorState from '../../components/ErrorState.astro';
import Chev from '../../components/Chev.astro';
import { getEnrollments, getProgress } from '../../lib/user';
import { getDailyGoals, localDate } from '../../lib/today';
import { rest } from '../../lib/api';
import { load } from '../../lib/page';

const t = Astro.locals.session!.token;
const today = localDate(Astro.cookies);
const data = await load(Astro.response, async () => {
  const [enrs, habits] = await Promise.all([getEnrollments(t), getDailyGoals(t, today)]);
  const ids = enrs.map((e) => e.id);
  const [prog, acts] = await Promise.all([
    getProgress(t, ids),
    ids.length ? rest<{ enrollment_id: string; updated_at: string }>('enrollment_steps', { select: 'enrollment_id,updated_at', enrollment_id: `in.(${ids.join(',')})`, order: 'updated_at.desc', limit: 1000 }, { token: t }).then((r) => r.rows) : Promise.resolve([]),
  ]);
  const last = new Map<string, string>();
  for (const a of acts) if (!last.has(a.enrollment_id)) last.set(a.enrollment_id, a.updated_at);
  return { enrs, prog, last, habits: habits ?? [] };
});
const WEEK = 7 * 86400000;
const items = data ? data.enrs.map((e) => {
  const p = data.prog.get(e.id);
  const lastAt = Date.parse(data.last.get(e.id) ?? e.started_at);
  const done = !!p && p.total_steps > 0 && p.completed_steps === p.total_steps;
  return { e, p, done, paused: !done && Date.now() - lastAt > WEEK };
}) : [];
const now = items.filter((x) => !x.done && !x.paused);
const paused = items.filter((x) => x.paused);
const finished = items.filter((x) => x.done);
const habits = data?.habits ?? [];
const empty = !!data && !items.length && !habits.length;
const pct = (p?: { completed_steps: number; total_steps: number }) => (p && p.total_steps ? Math.round((p.completed_steps / p.total_steps) * 100) : 0);
---
<Base title="رحلتي" noindex>
  {!data ? <ErrorState /> : empty ? (
    <div class="app-col screen">
      <h1>رحلتي</h1>
      <div class="state-screen">
        <svg class="art" viewBox="0 0 300 190" aria-hidden="true">
          <circle cx="150" cy="58" r="26" fill="var(--gold)"></circle>
          <path d="M20 64 C80 56 120 74 150 62 S230 54 280 62" fill="none" stroke="var(--line-strong)" stroke-width="2"></path>
          <path d="M150 176 C140 150 168 132 146 112 S150 86 150 84" fill="none" stroke="var(--line-strong)" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round"></path>
          <circle cx="150" cy="176" r="6" fill="var(--teal)"></circle>
        </svg>
        <h2>طريقك لم يبدأ بعد</h2>
        <p class="lead-dim">دقيقة واحدة، ونقترح عليك أول خطوة.</p>
        <a class="btn btn-primary btn-block" href="/start">من أين أبدأ؟</a>
        <a class="link-quiet" href="/discover">أو تصفّح المسارات</a>
      </div>
    </div>
  ) : (
    <div class="app-col screen">
      <h1>رحلتي</h1>

      {now.length > 0 && (
        <section class="screen-sec" aria-labelledby="now-h">
          <div class="title-row"><h2 id="now-h" class="sec-title">مساراتي الآن</h2>{now.length > 3 && <span class="lead-dim fs-0_85">كثرتها قد تشتّتك</span>}</div>
          <ul class="list">
            {now.map(({ e, p }) => (
              <li><a class="row-link card-link" href={`/journey/paths/${e.id}`}>
                <span class="grow"><span class="t">{e.path_versions?.title}</span><span class="s">{p ? `${p.completed_steps} من ${p.total_steps}` : ''}{e.path_versions?.status === 'withdrawn' ? '، قيد المراجعة' : ''}</span></span>
                <svg class="mini-arc" viewBox="0 0 40 24" aria-hidden="true"><path d="M38 22 Q20 -4 2 22" fill="none" stroke="var(--track)" stroke-width="2.5"></path><path d="M38 22 Q20 -4 2 22" fill="none" stroke="var(--teal)" stroke-width="2.5" pathLength="100" stroke-dasharray={`${pct(p)} 100`}></path></svg>
              </a></li>
            ))}
          </ul>
        </section>
      )}

      {habits.length > 0 && (
        <section class="screen-sec" aria-labelledby="hab-h">
          <h2 id="hab-h" class="sec-title">عاداتي اليومية</h2>
          <ul class="list">
            {habits.map((h) => (
              <li><a class="habit" href={`/journey/goals/${h.id}`}>
                <span class="num">{h.doneCount}</span>
                <span class="grow"><span class="t">{h.title}</span><span class="s">{h.today === true ? 'فعلتها اليوم' : h.days ? `${h.doneCount} من ${h.days} يومًا` : ''}</span></span>
                <Chev />
              </a></li>
            ))}
          </ul>
        </section>
      )}

      {paused.length > 0 && (
        <section class="screen-sec" aria-labelledby="pz-h">
          <h2 id="pz-h" class="sec-title">متوقفة</h2>
          <p class="lead-dim fs-0_85">لم تفتحها منذ أسبوع. تعود إليها متى شئت من حيث توقفت.</p>
          <ul class="list">
            {paused.map(({ e, p }) => (
              <li><a class="row-link card-link" href={`/journey/paths/${e.id}`}><span class="grow"><span class="t">{e.path_versions?.title}</span><span class="s">{p ? `${p.completed_steps} من ${p.total_steps}` : ''}</span></span><span class="end">عُد إليه</span></a></li>
            ))}
          </ul>
        </section>
      )}

      {finished.length > 0 && (
        <section class="screen-sec" aria-labelledby="fin-h">
          <h2 id="fin-h" class="sec-title">أنجزت</h2>
          <ul class="done-grid">
            {finished.map(({ e }) => (
              <li><a href={`/journey/paths/${e.id}`}><svg viewBox="0 0 34 22" aria-hidden="true"><circle cx="17" cy="13" r="7" fill="var(--gold)"></circle><path d="M2 20h30" stroke="var(--teal)" stroke-width="2" stroke-linecap="round"></path></svg>{e.path_versions?.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <p class="center"><a class="link-quiet" href="/journey/paths">كل مساراتي والأرشيف</a></p>
    </div>
  )}
</Base>
