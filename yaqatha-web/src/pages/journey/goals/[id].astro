---
import Base from '../../../layouts/Base.astro';
import BackBtn from '../../../components/BackBtn.astro';
import Horizon from '../../../components/Horizon.astro';
import { getDailyGoals, localDate } from '../../../lib/today';
import ErrorState from '../../../components/ErrorState.astro';
import PostButton from '../../../components/PostButton.astro';
import { getDomainsList, getEnrollments, getGoal, getGoalLinks, getSaved } from '../../../lib/user';
import { GOAL_STATUS, MATERIAL_TYPE } from '../../../lib/labels';
import { load } from '../../../lib/page';

const id = Astro.params.id!;
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.rewrite('/404');
const t = Astro.locals.session!.token;
const today = localDate(Astro.cookies);
const data = await load(Astro.response, async () => {
  const goal = await getGoal(t, id);
  if (!goal) return { goal: null };
  const [links, domains, myEnrs, saved, daily] = await Promise.all([getGoalLinks(t, id), getDomainsList(), getEnrollments(t), getSaved(t, 100), getDailyGoals(t, today, id)]);
  return { goal, links, domains, myEnrs, saved, daily: daily?.[0] ?? null };
});
if (data && !data.goal) return Astro.rewrite('/404'); // لا نكشف وجود هدف مستخدم آخر
const d = data && data.goal ? data : null;
const g = d?.goal;
const here = `/journey/goals/${id}`;
const archived = g?.status === 'archived';
const linkedEnr = new Set(d?.links.enrollments.map((l) => l.enrollment_id));
const linkedMat = new Set(d?.links.materials.map((l) => l.material_id));
const dom = d?.domains.find((x) => x.id === g?.domain_id)?.slug ?? '';
const MOVES: [string, string][] = g?.status === 'in_progress' ? [['paused', 'أوقفه مؤقتًا'], ['completed', 'أكملته']]
  : g?.status === 'paused' ? [['in_progress', 'استأنف'], ['completed', 'أكملته']]
  : g?.status === 'completed' ? [['in_progress', 'أعد فتحه']] : [['in_progress', 'ابدأ العمل عليه'], ['paused', 'أوقفه مؤقتًا']];
// الهدف اليومي: مربعات الأيام من يوم إنشائه (المنجز، والفائت، واليوم)
const dg = d?.daily ?? null;
const total = dg?.days ?? 30;
const startDay = dg ? dg.created_at.slice(0, 10) : today;
const dayIndex = (iso: string) => Math.round((Date.parse(iso) - Date.parse(startDay)) / 86400000);
const todayIdx = dg ? Math.max(0, dayIndex(today)) : 0;
const cells = dg ? Array.from({ length: total }, (_, i) => {
  const c = dg.checkins.find((x) => dayIndex(x.day) === i);
  return { n: i + 1, k: c?.done ? 'd-done' : (c && !c.done) || i < todayIdx ? 'd-miss' : i === todayIdx ? 'd-today' : '' };
}) : [];
const left = Math.max(0, total - dg?.doneCount! - (dg ? cells.filter((c) => c.k === 'd-miss').length : 0));
---
<Base title={g?.title ?? 'هدف'} noindex>
  {!d || !g ? <ErrorState /> : (
    <div class="app-col screen">
      <div class="screen-head"><BackBtn href="/journey/goals" label="رجوع إلى أهدافي" /><h1>{g.title}</h1></div>
      {g.description && <p class="step-text ws-pre-line">{g.description}</p>}
      {dg && !archived ? (
        <section class="stack sp-1" aria-label="أيام الهدف">
          <div class="center goal-sun">
            <Horizon done={dg.doneCount} total={total} label={`${dg.doneCount} من ${total} يومًا`} height={80} />
            <p class="big-count"><b>{dg.doneCount}</b> من {total} يومًا</p>
            {left > 0 && <p class="lead-dim">{left === 1 ? 'بقي يوم واحد' : left === 2 ? 'بقي يومان' : `بقي ${left} ${left <= 10 ? 'أيام' : 'يومًا'}`}</p>}
          </div>
          <div class="days" role="img" aria-label={`${dg.doneCount} أيام منجزة من ${total}`}>{cells.map((c) => <span class={c.k}>{c.n}</span>)}</div>
          <p class="legend"><span><i style="background:var(--teal)"></i>فعلتها</span><span><i style="border:1.5px dashed var(--line-strong)"></i>فاتت</span><span><i style="border:1.5px solid var(--gold)"></i>اليوم</span></p>
          {dg.today === null ? (
            <form method="post" action="/api/goal-checkin" class="stack sp-0_5">
              <input type="hidden" name="goal_id" value={g.id} /><input type="hidden" name="day" value={today} data-local-day /><input type="hidden" name="next" value={here} />
              <button class="btn btn-primary btn-block" type="submit" name="done" value="1">فعلتها اليوم</button>
              <button class="link-quiet center-self" type="submit" name="done" value="0">ليس اليوم</button>
            </form>
          ) : <p class="pill pill-teal justify-self-start">{dg.today ? 'علّمتها اليوم، بارك الله فيك' : 'ليس اليوم، وغدًا يوم جديد'}</p>}
        </section>
      ) : <p class="pill pill-teal justify-self-start">{GOAL_STATUS[g.status]}</p>}

      <div class="stack sp-1_5 pb-3">
        <div class={dg && !archived ? 'row goal-moves quiet' : 'row goal-moves'}>
          {archived
            ? <PostButton action="goal-restore" fields={{ id: g.id }} label="استعادة الهدف" kind="primary" small={false} />
            : <>{MOVES.map(([s, l]) => <PostButton action="goal-status" fields={{ id: g.id, status: s }} label={l} kind={s === 'completed' ? 'primary' : 'ghost'} />)}
               <PostButton action="goal-status" fields={{ id: g.id, status: 'archived' }} label="أرشفة" /></>}
        </div>

        <section aria-labelledby="enr-h">
          <h2 class="sec-title" id="enr-h">من مسار</h2>
          {d.links.enrollments.length ? (
            <ul class="mats">{d.links.enrollments.map((l) => (
              <li class="row justify-between py-0_8 bb-line">
                <a href={`/journey/paths/${l.enrollment_id}`}>{l.enrollments?.path_versions?.title ?? 'مسار'}</a>
                {!archived && <PostButton action="goal-unlink" fields={{ goal_id: g.id, enrollment_id: l.enrollment_id, next: here }} label="إزالة الربط" />}
              </li>))}</ul>
          ) : <p class="dim">لا مسارات مرتبطة. هدفك قائم بذاته، وهذا مقبول.</p>}
          {!archived && d.myEnrs.filter((e) => !linkedEnr.has(e.id)).length > 0 && (
            <form method="post" action="/api/goal-link" class="row mt-0_8">
              <input type="hidden" name="goal_id" value={g.id} /><input type="hidden" name="next" value={here} />
              <label class="sr-only" for="enrollment_id">مسار</label>
              <select id="enrollment_id" name="enrollment_id" class="input w-auto">{d.myEnrs.filter((e) => !linkedEnr.has(e.id)).map((e) => <option value={e.id}>{e.path_versions?.title}</option>)}</select>
              <button class="btn btn-ghost btn-sm" type="submit">اربط مسارًا</button>
            </form>
          )}
        </section>

        <section aria-labelledby="mat-h">
          <h2 class="sec-title" id="mat-h">المواد المرتبطة</h2>
          {d.links.materials.length ? (
            <ul class="mats">{d.links.materials.map((l) => (
              <li class="row justify-between py-0_8 bb-line">
                {l.materials ? <a href={`/library/${l.materials.slug}`}>{l.materials.title} <span class="chip">{MATERIAL_TYPE[l.materials.type]}</span></a> : <span class="unavailable">مادة غير متاحة حاليًا</span>}
                {!archived && <PostButton action="goal-material-remove" fields={{ goal_id: g.id, material_id: l.material_id }} label="إزالة" />}
              </li>))}</ul>
          ) : <p class="dim">لا مواد مرتبطة. يمكنك ربط مادة من المحفوظات.</p>}
          {!archived && d.saved.filter((s) => s.materials && !linkedMat.has(s.material_id)).length > 0 && (
            <form method="post" action="/api/goal-material-add" class="row mt-0_8">
              <input type="hidden" name="goal_id" value={g.id} />
              <label class="sr-only" for="material_id">مادة</label>
              <select id="material_id" name="material_id" class="input w-auto">{d.saved.filter((s) => s.materials && !linkedMat.has(s.material_id)).map((s) => <option value={s.material_id}>{s.materials!.title}</option>)}</select>
              <button class="btn btn-ghost btn-sm" type="submit">اربط مادة محفوظة</button>
            </form>
          )}
        </section>

        {!archived && (
          <details class="fold"><summary>تعديل الهدف</summary>
            <form method="post" action="/api/goal-update" class="stack sp-1 mt-1">
              <input type="hidden" name="id" value={g.id} /><input type="hidden" name="next" value={here} />
              <div class="field"><label for="title">العنوان</label><input id="title" name="title" type="text" required maxlength="120" value={g.title} /></div>
              <div class="field"><label for="description">التفاصيل</label><textarea id="description" name="description" maxlength="2000">{g.description ?? ''}</textarea></div>
              <div class="field"><label for="domain">المجال</label><select id="domain" name="domain"><option value="">—</option>{d.domains.map((x) => <option value={x.slug} selected={x.slug === dom}>{x.title}</option>)}</select></div>
              <div class="field"><label for="target_date">الموعد المستهدف</label><input id="target_date" name="target_date" type="date" value={g.target_date ?? ''} /></div>
              <div><button class="btn btn-primary btn-sm" type="submit">احفظ التعديلات</button></div>
            </form>
          </details>
        )}

        {archived && (
          <details class="fold"><summary>حذف الهدف نهائيًا</summary>
            <p class="dim my-0_8">يُمحى الهدف ووصفه نهائيًا ولا يمكن استرجاعه. أما المسارات والمواد المرتبطة فتبقى كما هي.</p>
            <PostButton action="goal-delete" fields={{ id: g.id }} label="احذف الهدف نهائيًا" kind="danger" />
          </details>
        )}
      </div>
    </div>
  )}
</Base>
