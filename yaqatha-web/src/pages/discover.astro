---
// اكتشف: الكثرة مكانها هنا. بحث، ثم «أصلح / أزداد من الخير»، ثم الاحتياجات كجمل بصوت المستخدم.
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import ErrorState from '../components/ErrorState.astro';
import Chev from '../components/Chev.astro';
import { getDoors, getHomepage, type Need } from '../lib/data';
import { rest } from '../lib/api';
import { PATH_LEVEL, durationLabel } from '../lib/labels';
import { load } from '../lib/page';

const tab = Astro.url.searchParams.get('t') === 'grow' ? 'grow' : 'fix';
const GROW = ['acquire_good_deed', 'increase_knowledge'];
const data = await load(Astro.response, async () => {
  const [doors, home, needs] = await Promise.all([
    getDoors(), getHomepage(),
    rest<Need>('needs', { select: 'id,slug,title,door_id,change_type', order: 'door_id,sort_order', limit: 200 }).then((r) => r.rows),
  ]);
  return { doors, startHere: [...home.startHere, ...home.featuredPaths].filter((p, i, a) => a.findIndex((x) => x.path_id === p.path_id) === i).slice(0, 6), needs };
});
const shown = data ? data.needs.filter((n) => (tab === 'grow') === GROW.includes(n.change_type ?? '')) : [];
const doorTitle = (id: number) => data?.doors.find((d) => d.id === id)?.title ?? '';
---
<Base title="اكتشف" description="ابحث بكلماتك، أو اختر ما تريد أن تعمل عليه: إصلاح شيء في نفسك، أو زيادة في الخير.">
  {!data ? <ErrorState /> : (
    <div class="app-col screen">
      <h1>اكتشف</h1>
      <SearchForm />
      <nav class="seg-tabs" aria-label="ماذا تريد؟">
        <a href="/discover" aria-current={tab === 'fix' ? 'true' : undefined}>أصلح</a>
        <a href="/discover?t=grow" aria-current={tab === 'grow' ? 'true' : undefined}>أزداد من الخير</a>
      </nav>
      <ul class="list-flat need-rows">
        {shown.map((n) => (
          <li><a class="row-link" href={`/needs/${n.slug}`}><span class="grow"><span class="t">{n.title}</span><span class="s">{doorTitle(n.door_id)}</span></span><Chev /></a></li>
        ))}
      </ul>

      {data.startHere.length > 0 && (
        <section class="screen-sec" aria-labelledby="sh-h">
          <div class="title-row"><h2 id="sh-h" class="sec-title">مسارات للبدء</h2><a class="link-quiet" href="/paths">كل المسارات</a></div>
          <ul class="hscroll">
            {data.startHere.map((p) => <li><a href={`/paths/${p.slug}`}><span class="d">{p.level && PATH_LEVEL[p.level] ? `${PATH_LEVEL[p.level]} · ` : ''}{durationLabel(p.duration_days)}</span><span class="t">{p.title}</span></a></li>)}
          </ul>
        </section>
      )}

      <ul class="list">
        <li><a class="row-link card-link" href="/library">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4v16H5zM10 4h4v16h-4zM15.5 5l3.5 1-3 14-3.5-1z"></path></svg></span>
          <span class="grow"><span class="t">المكتبة</span><span class="s">مقالات ومقاطع وكتب بمصادرها</span></span><Chev />
        </a></li>
        <li><a class="row-link card-link" href="/domains">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="2"></rect><rect x="13" y="4" width="7" height="7" rx="2"></rect><rect x="4" y="13" width="7" height="7" rx="2"></rect><rect x="13" y="13" width="7" height="7" rx="2"></rect></svg></span>
          <span class="grow"><span class="t">المجالات</span><span class="s">العبادة، والأخلاق، والأسرة، وغيرها</span></span><Chev />
        </a></li>
      </ul>
      <nav class="filters" aria-label="الأبواب">{data.doors.map((d) => <a href={`/doors/${d.slug}`}>{d.title}</a>)}</nav>
      <p class="center"><a class="link-quiet" href="/journey/goals/new">أو أنشئ هدفك بنفسك</a></p>
    </div>
  )}
</Base>
