---
import Admin from '../../layouts/Admin.astro';
import ErrorState from '../../components/ErrorState.astro';
import EmptyState from '../../components/EmptyState.astro';
import { assignees, listRequests, menteeProgress, type MenteeShare } from '../../lib/admin-followup';
import { REQUEST_STATUS, TOPICS, waLink } from '../../lib/support';
import { formatDate } from '../../lib/labels';
import { load } from '../../lib/page';

const s = Astro.locals.session!;
const role = Astro.locals.staffRole;
if (role !== 'manager' && role !== 'mentor') return Astro.rewrite('/404');
const status = Astro.url.searchParams.get('status') ?? '';
const data = await load(Astro.response, () => Promise.all([listRequests(s.token, status), role === 'manager' ? assignees(s.token) : Promise.resolve([] as string[])]));
const [items, people] = data ?? [null, []];
// من اختار أن يرى مشرفه تقدّمه: نجلب مساراته وأين وصل (دون أي شيء آخر)
const progress = new Map<string, MenteeShare>();
if (items) await Promise.all(items.filter((r) => r.share_progress || r.share_goals).slice(0, 50).map(async (r) => { const p = await menteeProgress(s.token, r.id); if (p) progress.set(r.id, p); }));
const back = status ? `?status=${status}` : '';
const tabs: [string, string][] = [['', 'المفتوحة'], ['new', 'جديدة'], ['contacted', 'تم التواصل'], ['active', 'مستمرة'], ['closed', 'منتهية']];
---
<Admin title="طلبات المتابعة">
  <div class="stack sp-1_2">
    <nav class="filters m-0" aria-label="الحالة">
      {tabs.map(([k, l]) => <a href={k ? `/admin/requests?status=${k}` : '/admin/requests'} aria-current={status === k ? 'true' : undefined}>{l}</a>)}
    </nav>
    {role === 'mentor' && <p class="faint m-0">تظهر هنا الطلبات المسندة إليك فقط.</p>}
    {!items ? <ErrorState /> : items.length === 0 ? (
      <EmptyState title="لا طلبات هنا" text={role === 'mentor' ? 'حين يُسند إليك المدير طلبًا يظهر هنا.' : 'حين يطلب أحد متابعة من الفريق يظهر هنا.'} />
    ) : (
      <ul class="adm-list">
        {items.map((r) => {
          const wa = waLink(r.phone, `السلام عليكم ${r.name}، معك فريق يقظة بخصوص طلب المتابعة`);
          return (
            <li id={`r-${r.id}`} class="adm-row d-block">
              <div class="row justify-between">
                <strong>{r.name}</strong>
                <span class={`state st-${r.status === 'closed' ? 'archived' : r.status === 'new' ? 'draft' : 'published'}`}>{REQUEST_STATUS[r.status]}</span>
              </div>
              <div class="meta mt-0_4">
                <span class="chip chip-gold">{TOPICS[r.topic] ?? r.topic}</span>
                <span class="chip">{r.gender === 'female' ? 'أخت' : 'أخ'}</span>
                {r.preferred_time && <span class="chip">الوقت المناسب: {r.preferred_time}</span>}
                <span class="faint fs-0_85">{formatDate(r.created_at)}</span>
              </div>
              <div class="row mt-0_7">
                {wa && <a class="btn btn-primary btn-sm" href={wa} target="_blank" rel="noopener">واتساب</a>}
                {r.phone && <a class="btn btn-ghost btn-sm" href={`tel:${r.phone.replace(/[^\d+]/g, '')}`} dir="ltr">{r.phone}</a>}
                {r.other_contact && <span class="dim fs-0_95">تواصل آخر: <span dir="auto">{r.other_contact}</span></span>}
              </div>
              {progress.has(r.id) && (
                <div class="mt-0_8 card-quiet">
                  {progress.get(r.id)!.paths && (<>
                    <strong class="fs-0_95">تقدّمه في المسارات (شاركه معك)</strong>
                    {progress.get(r.id)!.paths!.length ? (
                      <ul class="list-none p-0 m-0 stack sp-0_3">{progress.get(r.id)!.paths!.map((m) => <li class="fs-0_9">{m.title}: {m.done} من {m.total}<span class="faint">، آخر نشاط {formatDate(m.last_activity)}</span></li>)}</ul>
                    ) : <p class="faint fs-0_9">لم يبدأ مسارًا بعد.</p>}
                  </>)}
                  {progress.get(r.id)!.goals && (<>
                    <strong class="fs-0_95">التزامه بعاداته اليومية (شاركه معك)</strong>
                    {progress.get(r.id)!.goals!.length ? (
                      <ul class="list-none p-0 m-0 stack sp-0_3">{progress.get(r.id)!.goals!.map((g) => <li class="fs-0_9">{g.title}: {g.done}{g.days ? ` من ${g.days}` : ''} يومًا<span class="faint">، آخر 7 أيام: {g.last7}{g.last_day ? `، آخر يوم ${formatDate(g.last_day)}` : ''}</span></li>)}</ul>
                    ) : <p class="faint fs-0_9">لا عادات يومية الآن.</p>}
                  </>)}
                </div>
              )}
              <details class="fold mt-0_8">
                <summary>المتابعة{r.assigned_to ? ` · ${r.assigned_to}` : ' · غير مسنَد'}</summary>
                <form method="post" action="/api/admin/request-update" class="adm-form mt-0_8">
                  <input type="hidden" name="id" value={r.id} />
                  <input type="hidden" name="back" value={back} />
                  <div class="field"><label for={`st-${r.id}`}>الحالة</label>
                    <select id={`st-${r.id}`} name="status">{Object.entries(REQUEST_STATUS).map(([k, l]) => <option value={k} selected={r.status === k}>{l}</option>)}</select></div>
                  {role === 'manager' && (
                    <div class="field"><label for={`as-${r.id}`}>يتابعه</label>
                      <select id={`as-${r.id}`} name="assigned_to">
                        <option value="">— غير مسنَد —</option>
                        {[...new Set([...(people ?? []), ...(r.assigned_to ? [r.assigned_to] : [])])].map((e) => <option value={e} selected={r.assigned_to === e}>{e}</option>)}
                      </select>
                      <span class="hint">أضف متابِعين من «الإعدادات».</span></div>
                  )}
                  <div class="field"><label for={`n-${r.id}`}>ملاحظة للفريق</label>
                    <textarea class="minh-4" id={`n-${r.id}`} name="staff_note" maxlength="2000">{r.staff_note ?? ''}</textarea>
                    <span class="hint">لا تكتب تفاصيل شخصية أو ذنوبًا؛ يكفي ما يساعد على المتابعة.</span></div>
                  <div class="row"><button class="btn btn-primary btn-sm" type="submit">حفظ</button></div>
                </form>
              </details>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</Admin>
