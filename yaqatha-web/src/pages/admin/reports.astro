---
import Admin from '../../layouts/Admin.astro';
import ErrorState from '../../components/ErrorState.astro';
import EmptyState from '../../components/EmptyState.astro';
import { listReports } from '../../lib/admin-reports';
import { formatDate } from '../../lib/labels';
import { load } from '../../lib/page';

const s = Astro.locals.session!;
const status = Astro.url.searchParams.get('status') === 'resolved' ? 'resolved' : 'open';
const items = await load(Astro.response, () => listReports(s.token, status));
---
<Admin title="البلاغات">
  <div class="stack" style="--space:1.2rem">
    <nav class="filters" aria-label="الحالة" style="margin:0">
      <a href="/admin/reports" aria-current={status === 'open' ? 'true' : undefined}>المفتوحة</a>
      <a href="/admin/reports?status=resolved" aria-current={status === 'resolved' ? 'true' : undefined}>المُغلقة</a>
    </nav>
    <p class="faint" style="margin:0">بلاغات الزوار عن مشكلة في مادة (رابط معطّل، معلومة خاطئة، مصدر غير دقيق…). هوية المبلِّغ لا تظهر لأحد. راجع المادة وعدّلها، ثم أغلق البلاغ.</p>
    {!items ? <ErrorState /> : items.length === 0 ? (
      <EmptyState title={status === 'open' ? 'لا بلاغات مفتوحة' : 'لا بلاغات مغلقة بعد'} text={status === 'open' ? 'حين يبلّغ زائر عن مشكلة في مادة تظهر هنا.' : 'البلاغات التي تُغلق تظهر هنا.'} />
    ) : (
      <ul class="adm-list">
        {items.map((r) => (
          <li id={`rep-${r.id}`} class="adm-row" style="display:block">
            <div class="row" style="justify-content:space-between">
              <strong>{r.material?.title ?? 'مادة محذوفة'}</strong>
              <span class="faint">{formatDate(status === 'open' ? r.created_at : r.resolved_at)}</span>
            </div>
            <p style="margin:.5rem 0; white-space:pre-line">{r.note || <span class="faint">(بلا ملاحظة)</span>}</p>
            <div class="row" style="gap:.5rem">
              {r.material && <a class="btn btn-ghost btn-sm" href={`/admin/materials/${r.material.id}`}>عدّل المادة</a>}
              {r.material?.status === 'published' && <a class="btn btn-ghost btn-sm" href={`/library/${r.material.slug}`} target="_blank" rel="noopener">اعرضها كزائر</a>}
              <form method="post" action="/api/admin/report-status" style="margin:0">
                <input type="hidden" name="id" value={r.id} />
                <input type="hidden" name="status" value={status === 'open' ? 'resolved' : 'open'} />
                <button class={`btn btn-sm ${status === 'open' ? 'btn-primary' : 'btn-ghost'}`} type="submit">{status === 'open' ? 'تمت المعالجة' : 'أعد فتحه'}</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Admin>
