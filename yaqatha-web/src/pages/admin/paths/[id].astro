---
import Admin from '../../../layouts/Admin.astro';
import ErrorState from '../../../components/ErrorState.astro';
import LinkPicker from '../../../components/admin/LinkPicker.astro';
import { PUBLISH_STATUS, REVIEW_STATUS, taxonomyOptions } from '../../../lib/admin';
import { PATH_STATUS, VERSION_STATUS, getPathEditor, listAdminPaths, materialOptions } from '../../../lib/admin-paths';
import { CHANGE_TYPE, MATERIAL_TYPE, STEP_TYPE, durationLabel, formatDate, stepsLabel } from '../../../lib/labels';
import { load } from '../../../lib/page';

const s = Astro.locals.session!;
const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return Astro.rewrite('/404');
const data = await load(Astro.response, () => Promise.all([getPathEditor(s.token, id), taxonomyOptions(s.token), materialOptions(s.token), listAdminPaths(s.token)]));
if (data && !data[0]) return Astro.rewrite('/404');
const [ed, tax, mats, allPaths] = data ?? [null, null, null, []];
const pathTitle = new Map(allPaths.map((p) => [p.id, p]));
const work = ed?.work ?? null;
const isDraft = work?.status === 'draft';
const pid = ed?.path.id ?? '';
const matLabel = (m: { title: string; status: string; type: string }) => `${m.title} · ${MATERIAL_TYPE[m.type]}${m.status === 'published' ? '' : ` (${PUBLISH_STATUS[m.status]})`}`;
const unpublishedMats = (ed?.steps ?? []).flatMap((st) => st.step_materials).filter((x) => x.materials && x.materials.status !== 'published').length;
---
<Admin title={work?.title ?? 'مسار'}>
  {!ed || !tax || !mats ? <ErrorState /> : (
    <div class="stack sp-2">
      <div class="stack sp-0_8">
        <p class="row m-0">
          <span class={`state st-${ed.path.status}`}>{PATH_STATUS[ed.path.status]}</span>
          {work && <span class="chip">الإصدار {work.version_no}: {VERSION_STATUS[work.status]}</span>}
          {work && <span class="chip">{durationLabel(work.duration_days)} · {stepsLabel(ed.steps.length)}</span>}
          {ed.published && ed.path.status === 'published' && <a class="btn btn-ghost btn-sm" href={`/paths/${ed.path.slug}`} target="_blank" rel="noopener">عرض في الموقع</a>}
        </p>
        {isDraft && ed.published && <div class="notice">تعدّل على <strong>الإصدار {work!.version_no} (مسودة)</strong>. المنشور الآن هو الإصدار {ed.published.version_no} ويبقى كما هو حتى تنشر. من بدأ المسار سيُعرض عليه الانتقال للجديد دون أن يخسر تقدمه.</div>}
        {isDraft && !ed.published && <div class="notice"><strong>المسار لم يُنشر بعد.</strong> أضف الخطوات، ثم انشره من أسفل الصفحة.</div>}
        {work?.status === 'published' && (
          <div class="notice">
            <strong>هذا الإصدار منشور.</strong> يمكنك تصحيح نصوص الخطوات أو استبدال موادها مباشرة. لإضافة خطوات أو حذفها أو ترتيبها أنشئ إصدارًا جديدًا؛ من بدأ المسار لا يتأثر.
            <form class="mt-0_8" method="post" action="/api/admin/version-new-draft">
              <input type="hidden" name="path_id" value={pid} />
              <button class="btn btn-primary btn-sm" type="submit">أنشئ إصدارًا جديدًا للتعديل</button>
            </form>
          </div>
        )}
        {work && !isDraft && work.status !== 'published' && (
          <div class="notice" role="alert">
            <strong>لا يوجد إصدار منشور.</strong> {work.status === 'withdrawn' && work.withdrawn_note ? `سبب السحب: ${work.withdrawn_note}` : ''}
            <form class="mt-0_8" method="post" action="/api/admin/version-new-draft">
              <input type="hidden" name="path_id" value={pid} />
              <button class="btn btn-primary btn-sm" type="submit">أنشئ إصدارًا جديدًا من آخر إصدار</button>
            </form>
          </div>
        )}
        {unpublishedMats > 0 && <div class="notice" role="status">في الخطوات {unpublishedMats} مادة غير منشورة؛ لن يراها الزائر حتى تنشرها من «المواد».</div>}
      </div>

      {work && (
        <section id="steps" class="stack sp-0_8">
          <h2 class="fs-1_35">الخطوات</h2>
          {ed.steps.length === 0 && <p class="faint m-0">لا خطوات بعد. أضف الأولى من النموذج أدناه.</p>}
          <ol class="adm-list list-none">
            {ed.steps.map((st, i) => {
              const cur = st.step_materials[0]?.materials ?? null;
              return (
                <li id={`s-${st.id}`} class="adm-row d-block">
                  <details class="fold">
                    <summary>
                      <span class="gold">{i + 1}.</span> <strong>{st.title}</strong>
                      <span class="chip ms-0_4">{STEP_TYPE[st.type]}</span>
                      {cur && <span class="faint fs-0_9"> · {cur.title}{cur.status !== 'published' ? ' (غير منشورة)' : ''}</span>}
                    </summary>
                    <form method="post" action="/api/admin/step-save" class="adm-form mt-1">
                      <input type="hidden" name="path_id" value={pid} />
                      <input type="hidden" name="step_id" value={st.id} />
                      {isDraft ? (
                        <div class="field"><label for={`t-${st.id}`}>النوع</label>
                          <select id={`t-${st.id}`} name="type">{Object.entries(STEP_TYPE).map(([k, l]) => <option value={k} selected={st.type === k}>{l}</option>)}</select></div>
                      ) : <input type="hidden" name="type" value={st.type} />}
                      <div class="field"><label for={`ti-${st.id}`}>العنوان</label><input id={`ti-${st.id}`} name="title" type="text" required maxlength="200" value={st.title} /></div>
                      <div class="field"><label for={`in-${st.id}`}>التعليمات</label><textarea class="minh-6" id={`in-${st.id}`} name="instructions" maxlength="10000">{st.instructions ?? ''}</textarea>
                        <span class="hint">ما المطلوب من المستخدم في هذه الخطوة. يدعم Markdown.</span></div>
                      {(isDraft || cur) && (
                        <div class="field"><label for={`m-${st.id}`}>المادة</label>
                          <select id={`m-${st.id}`} name="material_id">
                            {isDraft && <option value="">— بلا مادة —</option>}
                            {mats.map((m) => <option value={m.id} selected={cur?.id === m.id}>{matLabel(m)}</option>)}
                          </select></div>
                      )}
                      <div class="row"><button class="btn btn-primary btn-sm" type="submit">حفظ الخطوة</button></div>
                    </form>
                    {isDraft && (
                      <div class="row mt-0_8">
                        {[['up', 'حرّك لأعلى', i > 0], ['down', 'حرّك لأسفل', i < ed.steps.length - 1]].filter(([, , ok]) => ok).map(([dir, label]) => (
                          <form method="post" action="/api/admin/step-move">
                            <input type="hidden" name="path_id" value={pid} /><input type="hidden" name="step_id" value={st.id} /><input type="hidden" name="dir" value={String(dir)} />
                            <button class="btn btn-ghost btn-sm" type="submit">{label}</button>
                          </form>
                        ))}
                        <form method="post" action="/api/admin/step-delete">
                          <input type="hidden" name="path_id" value={pid} /><input type="hidden" name="step_id" value={st.id} />
                          <button class="btn btn-danger btn-sm" type="submit">حذف الخطوة</button>
                        </form>
                      </div>
                    )}
                  </details>
                </li>
              );
            })}
          </ol>

          {isDraft && (
            <details class="fold" open={ed.steps.length === 0}>
              <summary><strong>+ أضف خطوة</strong></summary>
              <form method="post" action="/api/admin/step-add" class="adm-form mt-1">
                <input type="hidden" name="path_id" value={pid} />
                <input type="hidden" name="version_id" value={work.id} />
                <div class="field"><label for="new-type">النوع</label>
                  <select id="new-type" name="type">{Object.entries(STEP_TYPE).map(([k, l]) => <option value={k}>{l}</option>)}</select></div>
                <div class="field"><label for="new-title">العنوان</label><input id="new-title" name="title" type="text" required maxlength="200" placeholder="مثال: شاهد: فضل صلاة الفجر" /></div>
                <div class="field"><label for="new-ins">التعليمات</label><textarea class="minh-5" id="new-ins" name="instructions" maxlength="10000"></textarea></div>
                <div class="field"><label for="new-mat">المادة <span class="faint">(اختياري)</span></label>
                  <select id="new-mat" name="material_id"><option value="">— بلا مادة —</option>{mats.map((m) => <option value={m.id}>{matLabel(m)}</option>)}</select>
                  <span class="hint">لا تجد المادة؟ أضفها أولًا من «المواد» ثم ارجع.</span></div>
                <div class="row"><button class="btn btn-primary" type="submit">أضف الخطوة</button></div>
              </form>
            </details>
          )}
        </section>
      )}

      {work && (
        <section id="info" class="stack sp-0_8">
          <details class="fold">
            <summary><strong>بيانات الإصدار {work.version_no}</strong> (الاسم والوصف والمدة)</summary>
            <form method="post" action="/api/admin/version-save" class="adm-form mt-1">
              <input type="hidden" name="path_id" value={pid} />
              <input type="hidden" name="version_id" value={work.id} />
              <div class="field"><label for="v-title">اسم المسار</label><input id="v-title" name="title" type="text" required maxlength="200" value={work.title} /></div>
              <div class="field"><label for="v-desc">وصف قصير</label><textarea class="minh-5" id="v-desc" name="description" maxlength="1000">{work.description ?? ''}</textarea></div>
              <div class="field"><label for="v-purpose">الهدف منه</label><textarea class="minh-4" id="v-purpose" name="purpose" maxlength="2000">{work.purpose ?? ''}</textarea></div>
              {isDraft
                ? <div class="field"><label for="v-days">المدة بالأيام <span class="faint">(فارغ = مفتوح)</span></label><input id="v-days" name="duration_days" type="number" min="1" max="365" class="input maxw-10" value={work.duration_days ?? ''} /></div>
                : <p class="faint m-0">المدة: {durationLabel(work.duration_days)} (لا تتغير بعد النشر)</p>}
              <div class="row"><button class="btn btn-primary btn-sm" type="submit">حفظ</button></div>
            </form>
          </details>
        </section>
      )}

      {isDraft && (
        <section id="publish" class="stack sp-0_8">
          <h2 class="fs-1_35">النشر</h2>
          <form method="post" action="/api/admin/version-publish" class="adm-form">
            <input type="hidden" name="path_id" value={pid} />
            <input type="hidden" name="version_id" value={work!.id} />
            {work!.version_no > 1 && (
              <div class="field"><label for="changelog">ما الذي تغيّر في هذا الإصدار؟</label>
                <textarea class="minh-4" id="changelog" name="changelog" required maxlength="2000">{work!.changelog ?? ''}</textarea>
                <span class="hint">يراه من بدأ إصدارًا أقدم، ليقرر الانتقال للجديد.</span></div>
            )}
            <div class="row"><button class="btn btn-primary" type="submit">انشر {ed.published ? `الإصدار ${work!.version_no}` : 'المسار'}</button></div>
          </form>
        </section>
      )}


      <section id="ending" class="stack sp-0_8">
        <h2 class="fs-1_35">ختام المسار</h2>
        <p class="faint m-0">يظهر لمن أكمل كل الخطوات: أهداف يتبنّاها بنقرة لتصير عادة، ومسار يكمل به.</p>
        <div class="stack sp-0_5">
          <h3 class="fs-1_1">أهداف مقترحة</h3>
          {ed.goals.length === 0 && <p class="faint m-0">لا أهداف مقترحة بعد.</p>}
          <ul class="adm-list">
            {ed.goals.map((g) => (
              <li class="adm-row">
                <div class="grow"><span class="fw-600">{g.title}</span>{g.description && <p class="faint m-0_2-0-0 fs-0_92">{g.description}</p>}</div>
                <form method="post" action="/api/admin/path-goal-delete" class="acts"><input type="hidden" name="path_id" value={pid} /><input type="hidden" name="goal_id" value={g.id} /><button class="btn btn-ghost btn-sm" type="submit">حذف</button></form>
              </li>
            ))}
          </ul>
          <details class="fold">
            <summary><strong>+ أضف هدفًا مقترحًا</strong></summary>
            <form method="post" action="/api/admin/path-goal-add" class="adm-form mt-1">
              <input type="hidden" name="path_id" value={pid} />
              <div class="field"><label for="g-title">الهدف</label><input id="g-title" name="title" type="text" required maxlength="120" placeholder="مثال: صلاة الفجر في المسجد" /></div>
              <div class="field"><label for="g-desc">توضيح <span class="faint">(اختياري)</span></label><textarea class="minh-4" id="g-desc" name="description" maxlength="2000"></textarea></div>
              <div class="row"><button class="btn btn-primary btn-sm" type="submit">أضف</button></div>
            </form>
          </details>
        </div>
        <div class="stack sp-0_5">
          <h3 class="fs-1_1">المسار التالي</h3>
          {ed.next.length === 0 && <p class="faint m-0">لا مسارات تالية بعد.</p>}
          <ul class="adm-list">
            {ed.next.map((n) => {
              const np = pathTitle.get(n.next_path_id);
              return (
                <li class="adm-row">
                  <div class="grow"><a href={`/admin/paths/${n.next_path_id}`}>{np?.title ?? 'مسار'}</a>
                    {np && !np.published && <div class="meta"><span class="chip">غير منشور؛ لن يظهر للمستخدم</span></div>}</div>
                  <form method="post" action="/api/admin/path-next-delete" class="acts"><input type="hidden" name="path_id" value={pid} /><input type="hidden" name="next_path_id" value={n.next_path_id} /><button class="btn btn-ghost btn-sm" type="submit">إزالة</button></form>
                </li>
              );
            })}
          </ul>
          {allPaths.filter((p) => p.id !== pid && !ed.next.some((n) => n.next_path_id === p.id)).length > 0 && (
            <form method="post" action="/api/admin/path-next-add" class="row">
              <input type="hidden" name="path_id" value={pid} />
              <label class="sr-only" for="next">المسار التالي</label>
              <select id="next" name="next_path_id" class="input flex-1 minw-12">
                {allPaths.filter((p) => p.id !== pid && !ed.next.some((n) => n.next_path_id === p.id)).map((p) => <option value={p.id}>{p.title}{p.published ? '' : ' (غير منشور)'}</option>)}
              </select>
              <button class="btn btn-primary btn-sm" type="submit">أضف</button>
            </form>
          )}
        </div>
      </section>

      <section id="settings" class="stack sp-0_8">
        <details class="fold">
          <summary><strong>أين يظهر المسار</strong> (الاحتياجات والمجالات والمراجعة)</summary>
          <form method="post" action="/api/admin/path-links" class="adm-form mt-1">
            <input type="hidden" name="path_id" value={pid} />
            <LinkPicker {...tax} needIds={ed.needIds} domainIds={ed.domainIds} />
            <div class="field"><label for="ct">نوع التغيير</label>
              <select id="ct" name="change_type"><option value="">— غير محدد —</option>{Object.entries(CHANGE_TYPE).map(([k, l]) => <option value={k} selected={ed.path.change_type === k}>{l}</option>)}</select></div>
            <div class="field"><label for="rv">حالة المراجعة <span class="faint">(داخلية)</span></label>
              <select id="rv" name="review_status">{Object.entries(REVIEW_STATUS).map(([k, l]) => <option value={k} selected={(ed.review?.review_status ?? 'experimental') === k}>{l}</option>)}</select></div>
            <div class="field"><label for="note">ملاحظة للفريق</label><textarea class="minh-4" id="note" name="internal_note" maxlength="2000">{ed.review?.internal_note ?? ''}</textarea></div>
            <div class="row"><button class="btn btn-primary btn-sm" type="submit">حفظ</button></div>
          </form>
        </details>
      </section>

      {ed.published && (
        <section class="stack sp-0_8">
          <details class="fold">
            <summary><strong>إيقاف أو سحب</strong></summary>
            <div class="stack sp-1 mt-1">
              <form method="post" action="/api/admin/path-status" class="stack sp-0_5">
                <input type="hidden" name="path_id" value={pid} />
                <input type="hidden" name="status" value={ed.path.status === 'hidden' ? 'published' : 'hidden'} />
                <p class="faint m-0">{ed.path.status === 'hidden' ? 'المسار موقوف: لا يبدؤه أحد جديد.' : 'الإيقاف يخفي المسار عن الزوار ويمنع البدء الجديد، ومن بدأه يكمله عاديًا.'}</p>
                <div><button class="btn btn-ghost btn-sm" type="submit">{ed.path.status === 'hidden' ? 'أعد إظهار المسار' : 'أوقف البدء الجديد'}</button></div>
              </form>
              <form method="post" action="/api/admin/version-withdraw" class="stack sp-0_5">
                <input type="hidden" name="path_id" value={pid} />
                <input type="hidden" name="version_id" value={ed.published.id} />
                <p class="faint m-0">السحب للحالات الجادة (خطأ علمي مثلًا): يخفي محتوى الإصدار {ed.published.version_no} حتى عمّن بدأه، ويحفظ تقدمهم.</p>
                <div class="field"><label for="wnote">السبب (يراه المستخدمون)</label><input id="wnote" name="note" type="text" maxlength="1000" /></div>
                <div><button class="btn btn-danger btn-sm" type="submit">اسحب الإصدار {ed.published.version_no}</button></div>
              </form>
            </div>
          </details>
        </section>
      )}

      {ed.versions.length > 1 && (
        <section class="stack sp-0_6">
          <h2 class="fs-1_35">الإصدارات</h2>
          <ul class="adm-list">
            {ed.versions.map((v) => (
              <li class="adm-row"><div class="grow">
                <span class="fw-600">الإصدار {v.version_no}</span>
                <div class="meta"><span class="chip">{VERSION_STATUS[v.status]}</span>{v.published_at && <span class="faint fs-0_85">{formatDate(v.published_at)}</span>}</div>
                {v.changelog && <p class="faint m-0_3-0-0 fs-0_92">{v.changelog}</p>}
              </div></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}
</Admin>
