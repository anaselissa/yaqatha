---
import Admin from '../../layouts/Admin.astro';
import ErrorState from '../../components/ErrorState.astro';
import { dashboardStats } from '../../lib/admin';
import { impactStats } from '../../lib/admin-followup';
import { load } from '../../lib/page';
const s = Astro.locals.session!;
const stats = await load(Astro.response, () => dashboardStats(s.token));
const impact = stats ? await load(Astro.response, () => impactStats(s.token)) : null;
const pct = (a: number, b: number) => (b ? `${Math.round((a / b) * 100)}%` : '—');
const isManager = Astro.locals.staffRole === 'manager';
const first = s.name?.split(' ')[0];
---
<Admin title={first ? `أهلًا ${first}` : 'لوحة الإدارة'}>
  {!stats ? <ErrorState /> : (
    <div class="stack sp-2">
      {impact && (
        <section class="stack sp-0_9">
          <h2 class="fs-1_35">الأثر</h2>
          {isManager && impact.requests_new > 0 && (
            <a class="notice d-block td-none" href="/admin/requests?status=new"><strong>{impact.requests_new} طلب متابعة جديد</strong> بانتظار من يتواصل معه ←</a>
          )}
          <div class="stats">
            <div class="stat"><b>{impact.users_total}</b><span>مستخدم مسجّل · {impact.users_7d} هذا الأسبوع</span></div>
            <div class="stat"><b>{impact.active_7d}</b><span>نشِط هذا الأسبوع</span></div>
            <div class="stat"><b>{impact.started_total}</b><span>بدء مسار</span></div>
            <div class="stat"><b>{impact.completed_total}</b><span>إكمال مسار · {pct(impact.completed_total, impact.started_total)}</span></div>
          </div>
          {impact.paths.length > 0 && (
            <ul class="adm-list">
              {impact.paths.map((p) => (
                <li class="adm-row">
                  <div class="grow">
                    <a href={`/admin/paths/${p.id}`}>{p.title}</a>
                    <div class="meta">
                      <span class="chip">بدأه {p.started}</span>
                      <span class="chip chip-gold">أكمله {p.completed} ({pct(p.completed, p.started)})</span>
                      <span class="chip">تبنّى هدفًا مقترحًا {p.adopted_goals}</span>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
          <p class="faint m-0 fs-0_9">أعداد مجمّعة فقط؛ لا تعرض اللوحة أهداف أي شخص أو تقدمه.</p>
        </section>
      )}
      <section class="stack sp-0_9">
        <h2 class="fs-1_35">المحتوى الآن</h2>
        <div class="stats">
          <a class="stat" href="/admin/materials?status=published"><b>{stats.published}</b><span>مادة منشورة</span></a>
          <a class="stat" href="/admin/materials?status=draft"><b>{stats.draft}</b><span>مسودة</span></a>
          <a class="stat" href="/admin/materials?status=hidden"><b>{stats.hidden}</b><span>مخفية</span></a>
          <a class="stat" href="/admin/taxonomy"><b>{stats.needsPub}<small class="faint fs-1"> / {stats.needsAll}</small></b><span>احتياج منشور</span></a>
        </div>
        {stats.reports > 0 && (
          <div class="notice" role="status"><strong>{stats.reports} بلاغ مفتوح</strong> على مواد من الزوار. <a href="/admin/reports">راجع البلاغات</a></div>
        )}
      </section>

      <section class="stack sp-0_9">
        <h2 class="fs-1_35">ابدأ من هنا</h2>
        <div class="row">
          <a class="btn btn-primary" href="/admin/materials/new">أضف مادة</a>
          <a class="btn btn-ghost" href="/admin/materials/new?type=video">أضف مقطعًا من يوتيوب</a>
          <a class="btn btn-ghost" href="/admin/paths/new">أنشئ مسارًا</a>
          <a class="btn btn-ghost" href="/admin/taxonomy">انشر احتياجًا</a>
        </div>
        <div class="notice">
          <strong>كيف يظهر المحتوى للزائر؟</strong>
          أضف مادة واربطها باحتياج ومجال، ثم انشرها. بعدها انشر الاحتياج نفسه من «الاحتياجات والمجالات» ليظهر داخل بابه في الموقع.
        </div>
      </section>
    </div>
  )}
</Admin>
