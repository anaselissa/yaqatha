---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="طريق غير نافذ" noindex>
  <div class="app-col state-screen">
    <svg class="art" viewBox="0 0 260 170" aria-hidden="true">
      <circle cx="214" cy="58" r="22" fill="var(--gold)" opacity=".55"></circle>
      <path d="M20 152 C60 130 100 134 150 122" fill="none" stroke="var(--track)" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 12"></path>
      <path d="M148 100 V140 M196 100 V140" stroke="var(--line-strong)" stroke-width="5" stroke-linecap="round"></path>
      <rect x="138" y="92" width="68" height="14" rx="4" fill="var(--gold)"></rect>
      <path d="M152 92h9l-7 14h-9z M170 92h9l-7 14h-9z M188 92h9l-7 14h-9z" fill="var(--bg)"></path>
      <path d="M0 150 C80 136 150 166 260 146 V170 H0z" fill="var(--bg-2)"></path>
    </svg>
    <h1>طريق غير نافذ</h1>
    <p class="lead-dim">هذه الصفحة غير موجودة، أو نُقلت.</p>
    <a class="btn btn-primary btn-block" href="/">ارجع إلى يومك</a>
    <a class="link-quiet" href="/discover">أو ابحث في «اكتشف»</a>
  </div>
</Base>
