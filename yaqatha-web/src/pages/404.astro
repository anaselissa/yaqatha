---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Star from '../components/Star.astro';
import { getDoors } from '../lib/data';
import { load } from '../lib/page';
Astro.response.status = 404;
const doors = (await load({}, getDoors)) ?? [];
---
<Base title="الصفحة غير موجودة" noindex>
  <div class="container narrow section">
    <p class="gold ff-display fs-1_3 d-flex gap-0_6 items-center"><Star />٤٠٤</p>
    <h1 class="my-0_6-1">لم نجد هذه الصفحة</h1>
    <p class="dim mb-1_5">ربما تغيّر الرابط أو لم تعد المادة متاحة. ابحث عمّا تريد أو ابدأ من أحد الأبواب.</p>
    <SearchForm />
    {doors.length > 0 && (
      <div class="filters mt-1_8">{doors.map((d) => <a href={`/doors/${d.slug}`}>{d.title}</a>)}</div>
    )}
    <p class="mt-1_5"><a class="btn btn-ghost" href="/">الرئيسية</a></p>
  </div>
</Base>
