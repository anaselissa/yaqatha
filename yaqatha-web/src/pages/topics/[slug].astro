---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NeedList from '../../components/NeedList.astro';
import MaterialList from '../../components/MaterialList.astro';
import EmptyState from '../../components/EmptyState.astro';
import ErrorState from '../../components/ErrorState.astro';
import { getTopic, getTopicContent, resolveRedirect } from '../../lib/data';
import { load } from '../../lib/page';
const slug = Astro.params.slug!;
const data = await load(Astro.response, async () => {
  const topic = await getTopic(slug);
  if (!topic) return { topic: null, redirect: await resolveRedirect('topic', slug) };
  return { topic, redirect: null, content: await getTopicContent(topic.id) };
});
if (data && !data.topic) {
  if (data.redirect) return Astro.redirect(`/topics/${data.redirect}`, 301);
  return Astro.rewrite('/404');
}
const topic = data?.topic;
const c = data && 'content' in data ? data.content : null;
---
<Base title={topic?.title} description={topic?.description ?? (topic ? `مواد واحتياجات متعلقة بـ«${topic.title}».` : undefined)}>
  {!data || !topic || !c ? <ErrorState /> : (
    <div class="container">
      <header class="page-head">
        <Breadcrumbs items={[{ label: 'الرئيسية', href: '/' }, { label: 'المجالات', href: '/domains' }, { label: topic.title }]} />
        <h1>{topic.title}</h1>
        {topic.description && <p class="lead">{topic.description}</p>}
      </header>
      {c.needs.length > 0 && (
        <section class="section section-tight"><div class="section-title"><h2>احتياجات ذات صلة</h2></div><NeedList needs={c.needs} /></section>
      )}
      {c.materials.length > 0 && (
        <section class="section section-tight"><div class="section-title"><h2>مواد</h2>{c.hasMoreMaterials && <a href={`/library?topic=${topic.slug}`}>عرض كل المواد</a>}</div>
          <MaterialList items={c.materials} /></section>
      )}
      {!c.needs.length && !c.materials.length && (
        <section class="section section-tight">
          <EmptyState title="لم ننشر مواد في هذا الموضوع بعد"><a class="btn btn-primary" href="/search">ابحث</a><a class="btn btn-ghost" href="/discover">اكتشف احتياجك</a></EmptyState>
        </section>
      )}
    </div>
  )}
</Base>
