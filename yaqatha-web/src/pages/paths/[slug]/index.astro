---
// تفاصيل المسار قبل البدء: ما هو، وكم يأخذ، وخطواته، وزر واحد للبدء.
import Base from '../../../layouts/Base.astro';
import ErrorState from '../../../components/ErrorState.astro';
import BackBtn from '../../../components/BackBtn.astro';
import { getPath, resolveRedirect } from '../../../lib/data';
import { STEP_TYPE, durationLabel, formatDate } from '../../../lib/labels';
import { FEATURES } from '../../../config';
import { load } from '../../../lib/page';

const slug = Astro.params.slug!;
const data = await load(Astro.response, async () => {
  const r = await getPath(slug);
  return r ? { ...r, redirect: null } : { path: null, redirect: await resolveRedirect('path', slug) };
});
if (data && !data.path) {
  if (data.redirect) return Astro.redirect(`/paths/${data.redirect}`, 301);
  return Astro.rewrite('/404');
}
const path = data?.path;
const steps = data && 'steps' in data ? data.steps : [];
const ld = path && data && 'steps' in data ? {
  '@context': 'https://schema.org', '@type': 'HowTo', name: path.title, description: path.description ?? path.purpose ?? undefined, inLanguage: 'ar',
  step: data.steps.map((s) => ({ '@type': 'HowToStep', position: s.position, name: s.title, text: s.instructions ?? s.title })),
} : undefined;
const ICON: Record<string, string> = {
  watch: 'M8 6v12l10-6z', read: 'M5 4h10l4 4v12H5zM14 4v4h5', guidance: 'M12 3l2.5 5 5.5.8-4 3.9 1 5.5-5-2.6-5 2.6 1-5.5-4-3.9 5.5-.8z',
  exercise: 'M5 12l4 4 10-10', reflection: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18zM12 8v4l3 2', review: 'M4 12a8 8 0 1 0 3-6.2M4 4v4h4',
};
---
<Base title={path?.title} description={path?.description ?? path?.purpose ?? undefined} jsonLd={ld}>
  {!data || !path || !('steps' in data) ? <ErrorState /> : (
    <div class="app-col screen">
      <div class="screen-head"><BackBtn href="/discover" label="رجوع إلى اكتشف" /></div>
      <h1>{path.title}</h1>
      <p class="meta-line">
        <span>{durationLabel(path.duration_days)}</span>
        <span>{steps.length} خطوات</span>
      </p>
      {path.description && <p class="step-text">{path.description}</p>}
      {path.purpose && <p class="card-quiet"><strong>الغرض:</strong> {path.purpose}</p>}
      {path.version_no > 1 && data.changelog && <p class="notice"><strong>ما الجديد: </strong>{data.changelog}</p>}

      <section class="screen-sec" aria-labelledby="steps-h">
        <h2 id="steps-h" class="sec-title">الخطوات</h2>
        <ol class="list-flat path-steps">
          {steps.map((s, i) => (
            <li class={i >= 4 ? 'more-step' : ''}><a class="row-link" href={`/paths/${path.slug}/steps/${s.position}`}>
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON[s.type] ?? ICON.read}></path></svg></span>
              <span class="grow"><span class="t">{s.title}</span><span class="s">{STEP_TYPE[s.type] ?? ''}</span></span>
            </a></li>
          ))}
        </ol>
        {steps.length > 4 && <button class="link-quiet center-self" type="button" data-more-steps hidden>و{steps.length - 4 === 1 ? 'خطوة أخرى' : `${steps.length - 4} خطوات أخرى`}</button>}
      </section>

      {(data.needs.length > 0 || data.domains.length > 0) && (
        <nav class="filters" aria-label="يرتبط بـ">
          {data.needs.map((n) => <a href={`/needs/${n.slug}`}>{n.title}</a>)}
          {data.domains.map((d) => <a href={`/domains/${d.slug}`}>{d.title}</a>)}
        </nav>
      )}
      <p class="privacy-note"><svg viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2" aria-hidden="true"><path d="M12 3l7 3v6c0 4-3 7.5-7 9-4-1.5-7-5-7-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>كل مادة بمصدرها، والمدة للتوضيح: سِر بما يناسبك.</p>
      <p class="faint fs-0_8 center">الإصدار {path.version_no}{path.published_at ? `، نُشر في ${formatDate(path.published_at)}` : ''}</p>

      {FEATURES.accounts && steps.length > 0 && (
        <div class="dock dock-app">
          <form method="post" action="/api/start-path" data-path-state={path.path_id}>
            <input type="hidden" name="path_id" value={path.path_id} />
            <input type="hidden" name="next" value={`/paths/${path.slug}`} />
            <button class="btn btn-primary btn-block" type="submit">ابدأ هذا المسار</button>
          </form>
        </div>
      )}
    </div>
  )}
</Base>
<script>
  const b = document.querySelector<HTMLButtonElement>('[data-more-steps]');
  if (b) {
    const more = document.querySelectorAll<HTMLElement>('.more-step');
    more.forEach((x) => (x.hidden = true)); b.hidden = false;
    b.addEventListener('click', () => { more.forEach((x) => (x.hidden = false)); b.remove(); });
  }
</script>
