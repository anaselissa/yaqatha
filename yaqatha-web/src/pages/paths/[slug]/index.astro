---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ErrorState from '../../../components/ErrorState.astro';
import { getPath, resolveRedirect } from '../../../lib/data';
import { CHANGE_TYPE, MATERIAL_TYPE, STEP_TYPE, durationLabel, formatDate, stepsLabel } from '../../../lib/labels';
import { FEATURES } from '../../../config';
import { load } from '../../../lib/page';

const slug = Astro.params.slug!;
const data = await load(Astro.response, async () => {
  const r = await getPath(slug);
  return r ? { ...r, redirect: null } : { path: null, redirect: await resolveRedirect('path', slug) };
});
if (data && !data.path) {
  if (data.redirect) return Astro.redirect(`/paths/${data.redirect}`, 301);
  return Astro.rewrite('/404');
}
const path = data?.path;
const ld = path && data && 'steps' in data ? {
  '@context': 'https://schema.org', '@type': 'HowTo', name: path.title, description: path.description ?? path.purpose ?? undefined, inLanguage: 'ar',
  step: data.steps.map((s) => ({ '@type': 'HowToStep', position: s.position, name: s.title, text: s.instructions ?? s.title })),
} : undefined;
---
<Base title={path?.title} description={path?.description ?? path?.purpose ?? undefined} jsonLd={ld}>
  {!data || !path || !('steps' in data) ? <ErrorState /> : (
    <div class="container">
      <header class="page-head">
        <Breadcrumbs items={[{ label: 'الرئيسية', href: '/' }, { label: 'المسارات', href: '/paths' }, { label: path.title }]} />
        <div class="meta mb-0_9">
          <span class="chip chip-gold">{durationLabel(path.duration_days)}</span>
          <span class="chip">{stepsLabel(data.steps.length)}</span>
          {path.change_type && <span class="chip">{CHANGE_TYPE[path.change_type]}</span>}
        </div>
        <h1>{path.title}</h1>
        {path.description && <p class="lead">{path.description}</p>}
      </header>

      <div class="stack sp-1_5 py-1-2 maxw-measure">
        {path.purpose && <div class="notice"><strong>الغرض من المسار: </strong>{path.purpose}</div>}
        {path.duration_days && <p class="dim">المدة المقترحة {durationLabel(path.duration_days)}، وهي للتوضيح فقط. سِر بالسرعة التي تناسبك ولا حرج في التوقف والعودة.</p>}
        {FEATURES.accounts && data.steps.length > 0 && (
          <div>
            <form method="post" action="/api/start-path" data-path-state={path.path_id}>
              <input type="hidden" name="path_id" value={path.path_id} />
              <input type="hidden" name="next" value={`/paths/${path.slug}`} />
              <button class="btn btn-primary" type="submit">ابدأ هذا المسار</button>
            </form>
            <p class="faint fs-0_9 mt-0_5">يُحفظ تقدمك بحساب Google، وتستطيع التوقف والعودة متى شئت.</p>
          </div>
        )}
        {path.version_no > 1 && data.changelog && <div class="notice"><strong>ما الجديد في هذا الإصدار: </strong>{data.changelog}</div>}
      </div>

      <section class="section section-tight" aria-labelledby="steps-h">
        <div class="section-title"><h2 id="steps-h">خطوات المسار</h2></div>
        <ol class="steps">
          {data.steps.map((s) => (
            <li class="step">
              <div class="stack sp-0_5 col-2">
                <div class="meta"><span class="chip chip-gold">{STEP_TYPE[s.type] ?? s.type}</span></div>
                <h3><a href={`/paths/${path.slug}/steps/${s.position}`}>{s.title}</a></h3>
                {s.instructions && <p class="ins">{s.instructions}</p>}
                {s.step_materials.length > 0 && (
                  <ul class="step-mats">
                    {s.step_materials.map((sm) => sm.materials
                      ? <li><a href={`/library/${sm.materials.slug}`}>{sm.materials.title}</a> <span class="chip">{MATERIAL_TYPE[sm.materials.type]}</span></li>
                      : <li class="unavailable">هذه المادة غير متاحة حاليًا</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {(data.needs.length > 0 || data.domains.length > 0) && (
        <section class="section section-flush">
          <h2 class="section-title fs-1_4 c-dim">يرتبط بـ</h2>
          <div class="filters">
            {data.needs.map((n) => <a href={`/needs/${n.slug}`}>{n.title}</a>)}
            {data.domains.map((d) => <a href={`/domains/${d.slug}`}>{d.title}</a>)}
          </div>
        </section>
      )}
      <p class="faint fs-0_9 pb-1">الإصدار {path.version_no}{path.published_at ? ` · نُشر في ${formatDate(path.published_at)}` : ''}</p>
    </div>
  )}
</Base>
