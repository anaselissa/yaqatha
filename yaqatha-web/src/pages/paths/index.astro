---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PathCard from '../../components/PathCard.astro';
import Pager from '../../components/Pager.astro';
import EmptyState from '../../components/EmptyState.astro';
import ErrorState from '../../components/ErrorState.astro';
import { getDomains, listPaths } from '../../lib/data';
import { load } from '../../lib/page';

const q = Astro.url.searchParams;
const domain = q.get('domain')?.slice(0, 80) || undefined;
const duration = q.get('duration') === 'open' || q.get('duration') === 'fixed' ? (q.get('duration') as 'open' | 'fixed') : undefined;
const page = Math.max(1, parseInt(q.get('page') ?? '1', 10) || 1);
const filtered = Boolean(domain || duration);
const data = await load(Astro.response, async () => {
  const [list, domains] = await Promise.all([listPaths({ domain, duration, page }), getDomains()]);
  return { list, domains };
});
if (data && data.list.items.length === 0 && data.list.total > 0 && page > 1) {
  const u = new URLSearchParams(Astro.url.searchParams);
  u.set('page', String(data.list.pages));
  return Astro.redirect(`/paths?${u}`, 302);
}
const link = (over: Record<string, string | undefined>) => {
  const u = new URLSearchParams();
  for (const [k, v] of Object.entries({ domain, duration, ...over })) if (v) u.set(k, v);
  const s = u.toString();
  return s ? `/paths?${s}` : '/paths';
};
---
<Base title="المسارات" description="مسارات عملية مرتّبة بخطوات واضحة تنقلك من المعرفة إلى التطبيق، بمدد محددة أو مفتوحة."
  canonical={filtered ? '/paths' : page > 1 ? `/paths?page=${page}` : '/paths'} noindex={filtered}>
  {!data ? <ErrorState /> : (
    <div class="container">
      <header class="page-head">
        <Breadcrumbs items={[{ label: 'الرئيسية', href: '/' }, { label: 'المسارات' }]} />
        <h1>المسارات</h1>
        <p class="lead">المسار تجربة متتابعة بخطوات مرتّبة تساعدك على غرض محدد. ولا حرج في أن تسير فيه بالسرعة التي تناسبك.</p>
      </header>
      <section class="section pbs-1">
        <div class="filters" role="group" aria-label="المدة">
          <a href={link({ duration: undefined })} aria-current={!duration ? 'true' : undefined}>كل المسارات</a>
          <a href={link({ duration: 'fixed' })} aria-current={duration === 'fixed' ? 'true' : undefined}>بمدة محددة</a>
          <a href={link({ duration: 'open' })} aria-current={duration === 'open' ? 'true' : undefined}>مفتوحة</a>
        </div>
        {data.domains.length > 0 && (
          <div class="filters" role="group" aria-label="المجال">
            <a href={link({ domain: undefined })} aria-current={!domain ? 'true' : undefined}>كل المجالات</a>
            {data.domains.map((d) => <a href={link({ domain: d.slug })} aria-current={domain === d.slug ? 'true' : undefined}>{d.title}</a>)}
          </div>
        )}
        {data.list.items.length ? (
          <>
            <h2 class="sr-only">قائمة المسارات</h2>
            <div class="grid grid-2">{data.list.items.map((p) => <PathCard path={p} />)}</div>
            <Pager page={data.list.page} pages={data.list.pages} base="/paths" params={{ domain, duration }} />
          </>
        ) : (
          <EmptyState title={filtered ? 'لا توجد مسارات بهذه التصفية' : 'لم تُنشر مسارات بعد'} text={filtered ? 'جرّب تصفية أوسع.' : 'نعمل على إعداد المسارات بعناية، ولن نعرض إلا ما راجعناه.'}>
            {filtered && <a class="btn btn-primary" href="/paths">مسح التصفية</a>}
            <a class="btn btn-ghost" href="/library">تصفّح المواد</a>
          </EmptyState>
        )}
      </section>
    </div>
  )}
</Base>
