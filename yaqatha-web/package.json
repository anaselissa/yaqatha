    "test:admin-paths": "node --test --test-concurrency=1 tests/admin-paths.e2e.mjs",
    "test:admin-series": "node --test --test-concurrency=1 tests/admin-series.e2e.mjs",
    "test:admin-followup": "node --test --test-concurrency=1 tests/admin-followup.e2e.mjs",
    "test:quiz": "node --test --test-concurrency=1 tests/quiz.e2e.mjs",
